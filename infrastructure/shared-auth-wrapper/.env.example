# ============================================================
# Shared Auth Wrapper — Keycloak Configuration
# ============================================================

# Keycloak server URL (e.g. http://127.0.0.1:8083)
KEYCLOAK_URL=http://127.0.0.1:8083

# Keycloak realm name (e.g. "iacgenie")
KEYCLOAK_REALM=iacgenie

# Keycloak client ID registered for this wrapper
KEYCLOAK_CLIENT_ID=shared-auth-wrapper

# Keycloak client secret (generated in Keycloak admin console)
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Secret used to sign the session cookie (use a long random string)
SESSION_SECRET=change-this-to-a-long-random-string

# Port the auth wrapper listens on
PORT=3000

# Base URL of the actual application/dashboard behind this wrapper.
# The user is redirected here after a successful login.
# Examples:
#   DASHBOARD_URL=http://localhost:8080     (ClamAV)
#   DASHBOARD_URL=http://localhost:9090     (CrowdSec)
#   DASHBOARD_URL=http://localhost:3001     (PageGen)
DASHBOARD_URL=http://localhost:8080

# Name of the service (displayed on login/dashboard pages)
SERVICE_NAME="Shared Auth"

# ============================================================
# Optional settings
# ============================================================

# Redirect URL path for the OAuth2 callback (defaults to /callback)
# CALLBACK_PATH=/callback

# Path the user lands on after login (before redirect to DASHBOARD_URL)
# WELCOME_PATH=/dashboard

# Cookie name for the JWT token
# JWT_COOKIE_NAME=auth_token

# JWT expiration in seconds (default: 3600 = 1 hour)
# JWT_EXPIRES_IN=3600
