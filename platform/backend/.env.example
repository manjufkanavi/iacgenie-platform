# TerraGenius / IaCGenie Backend Configuration (Example)
# Copy this file to .env and fill in the values from OpenBao

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_PROVIDER=postgresql
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=terragenius
POSTGRES_USER=terragenius_user
POSTGRES_PASSWORD=***  # From OpenBao
SQLITE_PATH=iacgenie.db  # Only used if DATABASE_PROVIDER=sqlite

# ============================================
# AUTHENTICATION PROVIDER
# ============================================
# Options: local, keycloak, saml, oauth, google, github
AUTH_PROVIDER=***

# ============================================
# JWT CONFIGURATION (REQUIRED)
# ============================================
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(64))'
JWT_SECRET=***  # From OpenBao
JWT_AUDIENCE=terragenius-frontend
JWT_EXPIRATION=3600

# Grace period secrets for zero-downtime key rotation.
JWT_GRACE_SECRETS=***

# ============================================
# Refresh Token Configuration
# ============================================
JWT_REFRESH_EXPIRATION=604800

# ============================================
# KEYCLOAK CONFIGURATION
# ============================================
KEYCLOAK_URL=***  # From OpenBao
KEYCLOAK_REALM=terragenius
KEYCLOAK_CLIENT_ID=terragenius-web
KEYCLOAK_CLIENT_SECRET=***  # From OpenBao
KEYCLOAK_JWKS_URI=  # Auto-discovered if empty

# ============================================
# PASSWORD POLICY
# ============================================
PASSWORD_MIN_LENGTH=***
PASSWORD_REQUIRE_UPPERCASE=***
PASSWORD_REQUIRE_LOWERCASE=***
PASSWORD_REQUIRE_NUMBER=***
PASSWORD_REQUIRE_SPECIAL=***

# ============================================
# SAML CONFIGURATION
# ============================================
SAML_IDP_METADATA_URL=
SAML_ENTITY_ID=
SAML_ASSERTION_CONSUMER_SERVICE_URL=
SAML_NAME_ID_FORMAT=urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress
SAML_IDP_ENTITY_ID=
SAML_EMAIL_ATTRIBUTE=email
SAML_NAME_ATTRIBUTE=name
SAML_ROLE_ATTRIBUTE=role
SAML_KEY_FILE=
SAML_CERT_FILE=
SAML_DEBUG=false

# ============================================
# OAUTH SOCIAL LOGIN
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=***  # From OpenBao
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=***  # From OpenBao

# ============================================
# SESSION MANAGEMENT
# ============================================
MAX_CONCURRENT_SESSIONS=5
MAX_FAILED_LOGIN_ATTEMPTS=10
ACCOUNT_LOCKOUT_DURATION=900

# ============================================
# SERVER CONFIGURATION
# ============================================
HOST=0.0.0.0
PORT=8000
DEBUG=false  # Set true only for development
MOCK_MODE=false

# ============================================
# CORS CONFIGURATION
# ============================================
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379/1  # Update for production
# Rate limiting uses same Redis instance
