# TerraGenius Backend Configuration (Example)
# Copy this file to .env and fill in the values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_PROVIDER=sqlite
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=terragenius
POSTGRES_USER=terragenius_user
POSTGRES_PASSWORD=change_me_in_production
SQLITE_PATH=iacgenie.db

# ============================================
# AUTHENTICATION PROVIDER
# ============================================
# Options: local, keycloak, saml, oauth, google, github
# For MVP: use 'local' or 'keycloak'
AUTH_PROVIDER=local

# ============================================
# JWT CONFIGURATION (REQUIRED - used by all providers for internal tokens)
# ============================================
# CRITICAL: Must be a cryptographically random string >= 32 bytes.
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(64))'
JWT_SECRET=
JWT_ISSUER=terragenius-api
JWT_AUDIENCE=terragenius-frontend
JWT_EXPIRATION=3600

# Grace period secrets for zero-downtime key rotation.
# Comma-separated list of previous JWT_SECRET values.
JWT_GRACE_SECRETS=

# Refresh Token Configuration
JWT_REFRESH_EXPIRATION=604800

# ============================================
# KEYCLOAK CONFIGURATION (for AUTH_PROVIDER=keycloak)
# ============================================
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=terragenius
KEYCLOAK_CLIENT_ID=terragenius-web
KEYCLOAK_CLIENT_SECRET=<generate-from-keycloak>
KEYCLOAK_JWKS_URI=  # Auto-discovered if empty

# ============================================
# PASSWORD CONFIGURATION
# ============================================
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# ============================================
# SAML CONFIGURATION (for AUTH_PROVIDER=saml)
# ============================================
SAML_IDP_METADATA_URL=
SAML_ENTITY_ID=https://your-app.com/saml/sp
SAML_ASSERTION_CONSUMER_SERVICE_URL=https://your-app.com/api/saml/acs
SAML_NAME_ID_FORMAT=urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress
SAML_IDP_ENTITY_ID=
SAML_EMAIL_ATTRIBUTE=email
SAML_NAME_ATTRIBUTE=name
SAML_ROLE_ATTRIBUTE=role
SAML_KEY_FILE=
SAML_CERT_FILE=
SAML_DEBUG=false

# ============================================
# OAUTH SOCIAL LOGIN CONFIGURATION
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# SESSION MANAGEMENT
# ============================================
MAX_CONCURRENT_SESSIONS=5
MAX_FAILED_LOGIN_ATTEMPTS=10
ACCOUNT_LOCKOUT_DURATION=900

# ============================================
# SERVER CONFIGURATION
# ============================================
HOST=0.0.0.0
PORT=8000
DEBUG=true
MOCK_MODE=false

# ============================================
# CORS CONFIGURATION
# ============================================
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================
# REDIS (used by rate limiting & token revocation)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# FILE STORAGE
# ============================================
STORAGE_PATH=./project-files
MAX_FILE_SIZE=10485760

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO

# ============================================
# LITELLM GATEWAY (LLM Proxy)
# ============================================
# Path to LiteLLM config.yaml (fallback chains, model routing)
LITELLM_CONFIG_PATH=./src/llm_proxy/litellm_config.yaml

# Redis connection for LiteLLM response caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# LiteLLM API keys for downstream providers
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LiteLLM failover alerting
LITELLM_FAILOVER_WEBHOOK_URL=

# ============================================
# LOCAL LLM CONFIGURATION (LiteLLM Proxy)
# ============================================
# Local LLM model name (must match litellm_config.yaml entry)
LOCAL_LLM_MODEL=your_local_model_name

# Local LLM OpenAI-compatible endpoint
LOCAL_LLM_BASE_URL=http://localhost:1234/v1

# API key for local LLM (set to any value since local LLM doesn't validate tokens)
LOCAL_LLM_API_KEY=not-needed
