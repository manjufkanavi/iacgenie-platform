# Database Configuration
# Choose your database provider: supabase, sqlite, postgres
DATABASE_PROVIDER=postgres

# Authentication Provider
# Choose your authentication provider: local, keycloak
# Local authentication uses PostgreSQL with JWT tokens (default for development)
AUTH_PROVIDER=local

# Keycloak Configuration (for AUTH_PROVIDER=keycloak)
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=iacgenie
KEYCLOAK_CLIENT_ID=iacgenie-app
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_here

# Supabase Configuration (for DATABASE_PROVIDER=supabase)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PostgreSQL Configuration (for DATABASE_PROVIDER=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=iacgenie
POSTGRES_USER=iacgenie_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SSL_MODE=prefer

# SQLite Configuration (for DATABASE_PROVIDER=sqlite)
SQLITE_DB_PATH=iacgenie.db

# Local Authentication Configuration (for AUTH_PROVIDER=local)
JWT_SECRET=supersecret-change-in-production-use-openssl-rand-base64-32
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# Password Configuration (for AUTH_PROVIDER=local)
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# Development Settings
DEBUG=true
LOG_LEVEL=INFO

# API Keys
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_MISTRAL_API_KEY=your_mistral_api_key_here

# Security
ENCRYPTION_KEY=your_32_character_encryption_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Environment Variables

# API Configuration
VITE_API_BASE_URL=http://localhost:8000

# Development Configuration
VITE_DEV_MODE=true
VITE_DEBUG_LEVEL=info

# Monitoring & Observability
ENVIRONMENT=development
LOG_LEVEL=INFO
SENTRY_DSN=your_sentry_dsn_here

# Alerting Configuration
ALERT_WEBHOOK_URL=your_alert_webhook_url_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
ALERT_EMAIL_RECIPIENTS=admin@example.com,ops@example.com

# Google Cloud Configuration (optional)
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id

# SendGrid Email Service Configuration (for email notifications)
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM_ADDRESS=noreply@iacgenie.ai
SENDGRID_SANDBOX=false

# Email Service Settings
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY=1.0

# Frontend URL (for email links)
VITE_API_BASE_URL=http://localhost:5173

# ============================================
# LITELLM GATEWAY (LLM Proxy)
# ============================================
LITELLM_CONFIG_PATH=./backend/src/llm_proxy/litellm_config.yaml
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
