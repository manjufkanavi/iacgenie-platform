# =============================================================================
# LightSerp Configuration (EXAMPLE)
# =============================================================================
#
# DO NOT create a .env file from this template for production or development.
# All secrets are stored in OpenBao and loaded at startup via secrets-provider.ts.
#
# For development:
#   - Connect to the VM (192.168.0.118) where all services run
#   - Set OPENBAO_ADDR and OPENBAO_TOKEN environment variables
#   - The server will auto-load all secrets from OpenBao
#
# See: .agents/skills/openbao-secrets/SKILL.md for full documentation
# =============================================================================

# ── LightSerp Server ───────────────────────────────────────────────
LIGHTSERP_PORT=3000
NODE_ENV=production

# ── SearXNG (Search Engine) ───────────────────────────────────────
SEARXNG_URL=http://localhost:8070/search?format=json
SEARXNG_PORT=8070

# ── Redis (Cache) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ── NSQ (Message Queue) ───────────────────────────────────────────
NSQD_URL=nsqd:4150
NSQ_LOOKUPD_URL=nsqlookupd:4160
NSQ_HTTP_PORT=4161
NSQ_TCP_PORT=4150

# ── a12n-server (OAuth2/OpenID Provider) ──────────────────────────
A12N_URL=http://localhost:8083
A12N_PORT=8083

# ── Page Zen (Content Extraction) ─────────────────────────────────────────
PAGEZEN_URL=http://localhost:8076
PAGEZEN_PORT=8076
PAGEZEN_TIMEOUT=30000
PAGEZEN_HEALTH_INTERVAL=60000

# ── LightPanda (Headless Browser for JS Rendering) ─────────────────────
# Enable with LIGHTPANDA_ENABLED=true
# Lightweight Zig-based browser, 9x less RAM than Chrome, 11x faster
# Connects via Playwright CDP — drop-in replacement for headless Chrome
LIGHTPANDA_ENABLED=false
LIGHTPANDA_HOST=127.0.0.1
LIGHTPANDA_PORT=9222
LIGHTPANDA_WAIT_MS=5000

# ── Proxy Rotation ────────────────────────────────────────────────
# Comma-separated proxy URLs (datacenter, residential, mobile)
# PROXY_URLS=http://proxy1:8080,http://proxy2:8081,http://proxy3:8082
# PROXY_URLS= # Not configured — PageZen handles scraping directly

# ── Authentication ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
# When set, LightSerp uses a12n-server for OAuth2 tokens
# When unset, uses local JWT generation (HS256)

# ── Keycloak (SSO/OAuth2 provider) ────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=lightserp
KEYCLOAK_CLIENT_ID=lightserp-api
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_REDIRECT_URI=http://localhost:3000/auth/callback

# ── Email (SMTP2GO) ───────────────────────────────────────────────
# SMTP2GO API key for sending transactional emails
# Sign up at https://smtp2go.com and get your API key
SMTP2GO_API_KEY=change-me
EMAIL_FROM_ADDRESS=noreply@lightserp.ai

# SMTP server settings (SMTP2GO defaults shown)
SMTP_SERVER=mail.smtp2go.com
SMTP_PORT=2525

# Email retry settings
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY=1.0

# Sandbox mode — set to true to send test emails to sandbox recipients only
SMTP2GO_SANDBOX=false

# ── Cache Settings ────────────────────────────────────────────────
# Scrape result cache TTL in seconds (default: 3600 = 1 hour)
SCRAPING_CACHE_TTL=3600

# ── Telemetry ─────────────────────────────────────────────────────
# Enable/disable OpenTelemetry (default: disabled)
# TELEMETRY_ENABLED=false
