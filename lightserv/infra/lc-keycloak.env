# Keycloak Environment Variables — Lightserv
# Secrets sourced from OpenBao — DO NOT commit real passwords
# Copy to .env.local and fill from OpenBao

# Keycloak Database
KC_DB=postgres
KC_DB_URL_HOST=iacgenie-postgres-1
KC_DB_URL_PORT=5432
KC_DB_URL_DATABASE=lightserpkeycloak
KC_DB_USERNAME=lightserpkeycloak
KC_DB_PASSWORD=${KC_DB_PASSWORD}  # Fetch from OpenBao

# Keycloak Runtime
KC_HOSTNAME=lightserp.iacgenie.com
KC_PROXY=edge
KC_HOSTNAME_STRICT=false
KC_HTTP_ENABLED=true
KC_BOOTSTRAP_ADMIN_USERNAME=${KC_BOOTSTRAP_ADMIN_USERNAME:-admin}
KC_BOOTSTRAP_ADMIN_PASSWORD=${KC_BOOTSTRAP_ADMIN_PASSWORD}  # Fetch from OpenBao
