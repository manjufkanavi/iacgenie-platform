# Page Zen — Mock Content Extraction Service
#
# Lightweight HTTP server for content extraction in development.
# Falls back to Readability when unavailable.

FROM node:22-slim

WORKDIR /app

# Create package.json for ESM
RUN echo '{"type":"module","name":"pagezen-mock","version":"1.0.0"}' > package.json

# Install express
RUN npm install express

COPY pagezen-server.mjs /app/server.mjs

EXPOSE 8082

CMD ["node", "server.mjs"]
