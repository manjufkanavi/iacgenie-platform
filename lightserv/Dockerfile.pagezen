# =============================================================================
# PageZen — Minimal Docker Build
# =============================================================================
# Lightweight HTTP server for content extraction in development.
# Falls back to Readability when unavailable.
# =============================================================================

FROM node:22-alpine AS builder

WORKDIR /app

# Install build deps
RUN apk add --no-cache python3 make g++

# Install express
RUN npm init -y && npm install express

COPY pagezen-server.mjs /app/server.mjs

# ---- Production ----
FROM node:22-alpine AS production

WORKDIR /app

# Copy only production files
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/server.mjs ./server.mjs

# Create non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup -h /app -s /sbin/nologin && \
    chown -R appuser:appgroup /app
USER appuser

EXPOSE 8082

CMD ["node", "server.mjs"]
