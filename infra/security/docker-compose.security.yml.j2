# =============================================================================
# Security Services — ClamAV + ClamAV Web Client + CrowdSec + CrowdSec Web UI
# =============================================================================
# Services:
#   - clamav/clamav:latest → Antivirus engine (port 3310)
#   - rguziy/clamav-web-client:latest → ClamAV Web UI (port 9091)
#   - crowdsecurity/crowdsec:latest → WAF/IDS engine (port 18080)
#   - ghcr.io/theduffman85/crowdsec-web-ui:latest → CrowdSec Web Dashboard (port 3030)
# =============================================================================
---
name: iacgenie
services:
  # ─── ClamAV Antivirus Engine ───
  clamav:
    image: clamav/clamav:latest
    container_name: security_clamav
    restart: unless-stopped
    ports:
      - "127.0.0.1:3310:3310"
    volumes:
      - security_clamav_db:/var/lib/clamav
    healthcheck:
      test: ["CMD-SHELL", "clamdcheck || exit 1"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 120s
    networks:
      - iacgenie_backend
    deploy:
      resources:
        limits:
          memory: 1G

  # ─── ClamAV Web Client (Web UI) ───
  clamav-web:
    image: rguziy/clamav-web-client:latest
    container_name: security_clamav_web
    restart: unless-stopped
    depends_on:
      - clamav
    environment:
      - CLAMAV_HOST=clamav
      - CLAMAV_PORT=3310
    ports:
      - "127.0.0.1:9091:8080"
    networks:
      - iacgenie_backend
    deploy:
      resources:
        limits:
          memory: 256M
          cpus: "0.25"

  # ─── CrowdSec — Core Engine ───
  crowdsec:
    image: crowdsecurity/crowdsec:latest
    container_name: security_crowdsec
    restart: unless-stopped
    environment:
      COLLECTIONS: "crowdsecurity/nginx crowdsecurity/http-cve crowdsecurity/whitelist-good-actors crowdsecurity/scrapy"
    volumes:
      - /var/log/nginx:/var/log/nginx:ro
      - security_crowdsec_db:/var/lib/crowdsec/data/
      - security_crowdsec_config:/etc/crowdsec/
      - security_crowdsec_home:/root
    ports:
      - "127.0.0.1:18080:8080"
    networks:
      - iacgenie_backend
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: "0.5"

  # ─── CrowdSec Web UI (Dashboard) ───
  crowdsec-web:
    image: ghcr.io/theduffman85/crowdsec-web-ui:latest
    container_name: security_crowdsec_web
    user: "1000:1000"
    restart: unless-stopped
    depends_on:
      - crowdsec
    environment:
      - CONFIG_INSTANCE_LAPI_URL=http://crowdsec:8080
      - CONFIG_INSTANCE_LAPI_AUTH_USERNAME=crowdsec-web-ui
      - CONFIG_INSTANCE_LAPI_AUTH_PASSWORD=crowdsec-web-password
      - CONFIG_SERVER_PORT=3000
      - CONFIG_PERSIST_OVERRIDES=false
    ports:
      - "127.0.0.1:3030:3000"
    networks:
      - iacgenie_backend
    volumes:
      - security_crowdsec_web_data:/app/data
    deploy:
      resources:
        limits:
          memory: 256M
          cpus: "0.25"

volumes:
  security_clamav_db:
  security_crowdsec_db:
  security_crowdsec_config:
  security_crowdsec_home:
  security_crowdsec_web_data:

networks:
  iacgenie_backend:
    external: true
    name: iacgenie_iacgenie-backend
