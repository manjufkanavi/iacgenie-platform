# =============================================================================
# Security Services — ClamAV (Virus Scanning) + CrowdSec (WAF/IDS)
# =============================================================================
# ClamAV: Open-source antivirus engine for file scanning
# CrowdSec: Collaborative IPS/WAF with community blocklist
# =============================================================================
---
services:
  clamav:
    image: clamav/clamav:1.2
    container_name: clamav
    restart: unless-stopped
    ports:
      - "127.0.0.1:3310:3310"
    volumes:
      - clamav_db:/var/lib/clamav
    healthcheck:
      test: ["CMD-SHELL", "clamdcheck || exit 1"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 120s
    networks:
      - iacgenie-backend
    deploy:
      resources:
        limits:
          memory: 1G

  crowdsec:
    image: crowdsecurity/crowdsec:latest
    container_name: crowdsec
    restart: unless-stopped
    environment:
      COLLECTIONS: "crowdsecurity/nginx crowdsecurity/http-cve crowdsecurity/whitelist-good-actors crowdsecurity/scrapy"
    volumes:
      - ./nginx-logs:/var/log/nginx:ro
      - crowdsec_db:/var/lib/crowdsec/data/
      - crowdsec_config:/etc/crowdsec/
      - crowdsec_home:/root
    ports:
      - "127.0.0.1:8080:8080"
    networks:
      - iacgenie-backend
    security_opt:
      - no-new-privileges:true
    depends_on:
      - clamav
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: "0.5"

volumes:
  clamav_db:
  crowdsec_db:
  crowdsec_config:
  crowdsec_home:

networks:
  iacgenie-backend:
    external: true
