# =============================================================================
# Grafana — Dashboard Provisioning
# =============================================================================

apiVersion: 1

providers:
  - name: "iacgenie-dashboards"
    orgId: 1
    folder: "IacGenie"
    type: file
    disableDeletion: false
    updateIntervalSeconds: 30
    allowUiUpdates: true
    options:
      path: /etc/grafana/provisioning/dashboards/json
