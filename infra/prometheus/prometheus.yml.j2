# Prometheus Configuration — IacGenie Platform
# Collects metrics from: Prometheus, Alertmanager, Loki, Docker containers,
# Node Exporter (host), Falcosidekick (security events)
# Retention: 30 days

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  scrape_timeout: 10s

rule_files:
  - "alert_rules.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  # ── Prometheus self-monitoring ──
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  # ── Alertmanager ──
  - job_name: "alertmanager"
    static_configs:
      - targets: ["alertmanager:9093"]

  # ── Loki ──
  - job_name: "loki"
    static_configs:
      - targets: ["loki:3100"]

  # ── Node Exporter — Host-level metrics (CPU, memory, disk, network) ──
  - job_name: "node-exporter"
    static_configs:
      - targets: ["node-exporter:9100"]

  # ── Docker container metrics via Docker socket ──
  - job_name: "docker"
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
    relabel_configs:
      - source_labels: [__meta_docker_container_name]
        regex: "/iacgenie.*"
        action: keep

  # ── Falcosidekick — Security event metrics ──
  - job_name: "falcosidekick"
    static_configs:
      - targets: ["falcosidekick:2810"]

  # ── Nginx metrics (stub — add nginx-exporter when deployed) ──
  # - job_name: "nginx"
  #   static_configs:
  #     - targets: ["nginx-exporter:9113"]
