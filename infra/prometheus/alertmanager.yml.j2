# Alertmanager Configuration — IacGenie Platform
# Routes: critical → webhook/Telegram, warning → batched, security (Falco) → immediate
# Receivers: default webhook, critical webhook, warning webhook, security webhook

global:
  resolve_timeout: 5m
  smtp_smarthost: "${ALERTMANAGER_SMTP_HOST:-}"
  smtp_from: "${ALERTMANAGER_SMTP_FROM:-}"
  smtp_auth_username: "${ALERTMANAGER_SMTP_USER:-}"
  smtp_auth_password: "${ALERTMANAGER_SMTP_PASS:-}"

route:
  group_by: ["alertname", "severity", "category"]
  group_wait: 10s
  group_interval: 5m
  repeat_interval: 1h
  receiver: "default"

  routes:
    # Security alerts (Falco/Falcosidekick) → immediate + all receivers
    - match:
        category: security
      receiver: "security-alerts"
      repeat_interval: 5m
      continue: true

    # Critical alerts → immediate notification
    - match:
        severity: critical
      receiver: "critical-alerts"
      repeat_interval: 15m
      continue: true

    # Warning alerts → batched
    - match:
        severity: warning
      receiver: "warning-alerts"
      repeat_interval: 1h

receivers:
  - name: "default"
    webhook_configs:
      - url: "${ALERTMANAGER_WEBHOOK_URL:-http://localhost:5001/webhook}"
        send_resolved: true

  - name: "critical-alerts"
    webhook_configs:
      - url: "${ALERTMANAGER_WEBHOOK_URL:-http://localhost:5001/webhook}"
        send_resolved: true
    # Email fallback for critical alerts (uncomment when configured)
    # email_configs:
    #   - to: "admin@iacgenie.com"
    #     send_resolved: true

  - name: "warning-alerts"
    webhook_configs:
      - url: "${ALERTMANAGER_WEBHOOK_URL:-http://localhost:5001/webhook}"
        send_resolved: true

  - name: "security-alerts"
    webhook_configs:
      - url: "${ALERTMANAGER_WEBHOOK_URL:-http://localhost:5001/webhook}"
        send_resolved: true
    # Telegram fallback for security alerts
    # telegram_configs:
    #   - bot_token: "${TELEGRAM_BOT_TOKEN:-}"
    #     chat_id: "${TELEGRAM_CHAT_ID:-}"
    #     send_resolved: true

# Inhibit rules — suppress warnings when critical exists
inhibit_rules:
  - source_match:
      severity: critical
    target_match:
      severity: warning
    equal: ["alertname", "category"]
