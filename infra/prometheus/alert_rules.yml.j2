groups:
  # =========================================================================
  # Service Availability Alerts
  # =========================================================================
  - name: service_availability
    interval: 30s
    rules:
      # All container services down
      - alert: ServiceDown
        expr: up == 0
        for: 2m
        labels:
          severity: critical
          category: availability
        annotations:
          summary: "Service {{ $labels.job }} is down"
          description: "{{ $labels.job }} has been down for more than 2 minutes. Check logs with: docker logs iacgenie_{{ $labels.job }}"

      # All containers healthy
      - alert: ContainersUnhealthy
        expr: docker_container_health_status != 1
        for: 5m
        labels:
          severity: warning
          category: availability
        annotations:
          summary: "Container {{ $labels.container }} is unhealthy"
          description: "Container {{ $labels.container }} status: {{ $value }}"

  # =========================================================================
  # Resource Utilization Alerts
  # =========================================================================
  - name: resource_utilization
    interval: 30s
    rules:
      # Container memory usage > 80%
      - alert: ContainerMemoryHigh
        expr: container_memory_usage_bytes / container_spec_memory_limit_bytes > 0.8
        for: 5m
        labels:
          severity: warning
          category: resources
        annotations:
          summary: "Container {{ $labels.name }} memory usage > 80%"
          description: "{{ $labels.name }} using {{ humanize $value | humanize 100 }}% of memory limit"

      # Container CPU usage > 80%
      - alert: ContainerCPUHigh
        expr: rate(container_cpu_usage_seconds_total[5m]) / container_spec_cpu_quota * container_spec_cpu_period > 0.8
        for: 5m
        labels:
          severity: warning
          category: resources
        annotations:
          summary: "Container {{ $labels.name }} CPU usage > 80%"
          description: "{{ $labels.name }} CPU usage high"

      # Disk usage > 85%
      - alert: DiskSpaceHigh
        expr: (1 - node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"}) > 0.85
        for: 5m
        labels:
          severity: warning
          category: resources
        annotations:
          summary: "Disk usage > 85%"
          description: "Disk space critical — check immediately"

      # Disk usage > 95%
      - alert: DiskSpaceCritical
        expr: (1 - node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"}) > 0.95
        for: 1m
        labels:
          severity: critical
          category: resources
        annotations:
          summary: "Disk usage > 95%"
          description: "CRITICAL — disk almost full"

  # =========================================================================
  # Database Alerts
  # =========================================================================
  - name: database_alerts
    interval: 30s
    rules:
      # PostgreSQL connection pool exhaustion > 80%
      - alert: PostgresConnectionsHigh
        expr: pg_stat_activity_count / pg_settings_max_connections > 0.8
        for: 5m
        labels:
          severity: warning
          category: database
        annotations:
          summary: "PostgreSQL connection pool > 80%"
          description: "PostgreSQL has {{ $value | humanize 100 }}% of max connections in use"

      # PostgreSQL replication lag > 30s
      - alert: PostgresReplicationLag
        expr: pg_replication_lag_seconds > 30
        for: 2m
        labels:
          severity: critical
          category: database
        annotations:
          summary: "PostgreSQL replication lag > 30s"
          description: "Replication lag: {{ $value | humanize }}s"

  # =========================================================================
  # Nginx Alerts
  # =========================================================================
  - name: nginx_alerts
    interval: 30s
    rules:
      # Nginx error rate > 5%
      - alert: NginxErrorRateHigh
        expr: rate(http_requests_total{status=~"5.."}[5m]) / rate(http_requests_total[5m]) > 0.05
        for: 2m
        labels:
          severity: warning
          category: web
        annotations:
          summary: "Nginx 5xx error rate > 5%"
          description: "5xx error rate: {{ $value | humanize 100 }}%"

      # Nginx response time > 2s
      - alert: NginxSlowResponse
        expr: histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m])) > 2
        for: 5m
        labels:
          severity: warning
          category: web
        annotations:
          summary: "Nginx 95th percentile response time > 2s"
          description: "P95 response time: {{ $value | humanize }}s"

  # =========================================================================
  # Security Alerts (Falco + Auth)
  # =========================================================================
  - name: security_alerts
    interval: 30s
    rules:
      # Falco events received (indicates Falco is alive + detecting)
      - alert: FalcoEventReceived
        expr: falco_event_total > 0
        for: 10m
        labels:
          severity: info
          category: security
        annotations:
          summary: "Falco security event detected: {{ $labels.rule }}"
          description: "Rule {{ $labels.rule }} fired — check Falcosidekick UI at http://127.0.0.1:2800"

      # Falco stopped sending events (Falco might be down)
      - alert: FalcoSilent
        expr: falco_event_total == 0
        for: 15m
        labels:
          severity: critical
          category: security
        annotations:
          summary: "Falco has stopped reporting events"
          description: "No Falco events in 15 minutes — check falco container"

      # Failed auth attempts > 10/min
      - alert: BruteForceAttempt
        expr: rate(http_requests_total{status="401", handler="auth"}[5m]) > 10
        for: 1m
        labels:
          severity: critical
          category: security
        annotations:
          summary: "Possible brute force attack detected"
          description: "Auth failures: {{ $value | humanize }}/min"

      # Keycloak login failures
      - alert: KeycloakAuthFailures
        expr: rate(keycloak_auth_failures_total[5m]) > 5
        for: 2m
        labels:
          severity: critical
          category: security
        annotations:
          summary: "Keycloak auth failures > 5/min"
          description: "Failed auth attempts: {{ $value | humanize }}/min"

  # =========================================================================
  # Infrastructure Alerts
  # =========================================================================
  - name: infrastructure
    interval: 30s
    rules:
      # Host CPU > 90%
      - alert: HostCPUHigh
        expr: 100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 90
        for: 5m
        labels:
          severity: warning
          category: infrastructure
        annotations:
          summary: "Host CPU usage > 90%"
          description: "CPU at {{ $value | humanize 100 }}%"

      # Host load average > 4
      - alert: HostLoadHigh
        expr: node_load1 > 4
        for: 5m
        labels:
          severity: warning
          category: infrastructure
        annotations:
          summary: "Host load average > 4"
          description: "Load average: {{ $value }}"

      # Prometheus scrape failures
      - alert: PrometheusScrapeFailed
        expr: up == 0
        for: 3m
        labels:
          severity: warning
          category: monitoring
        annotations:
          summary: "Prometheus scrape target down: {{ $labels.job }}"
          description: "{{ $labels.job }} has not responded to scrapes for 3 minutes"
