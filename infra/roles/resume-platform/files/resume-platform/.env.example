# Server
HOST=0.0.0.0
PORT=3006

# Database (shared PostgreSQL)
DATABASE_URL=postgresql+asyncpg://resume_platform:CHANGE_ME@postgres:5432/iacgenie

# MinIO (shared)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=resume-files
MINIO_SECURE=false

# Keycloak OIDC
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=iacgenie
KEYCLOAK_CLIENT_ID=resume-platform
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ISSUER=https://iacgenie.com/auth/realms/iacgenie

# Ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:0.5b

# API Secret (for internal n8n callbacks)
API_SECRET=CHANGE_ME

# File upload limits
MAX_FILE_SIZE_MB=10

# CORS
ALLOWED_ORIGINS=https://resume.iacgenie.com
