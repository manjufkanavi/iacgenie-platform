[Unit]
Description=IacGenie Monitoring Stack
Documentation=https://hermes-agent.nousresearch.com/docs
After=docker.service prometheus.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=mkanavi
WorkingDirectory=/home/mkanavi/docker/iacgenie
ExecStartPre=/usr/bin/docker compose config --quiet
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=120
TimeoutStopSec=60
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
