# Keycloak Environment Variables
# Managed by Ansible
# Keycloak 26.x uses KC_BOOTSTRAP_* for first-boot admin creation

# Keycloak Admin (used by docker-compose.yml)
KEYCLOAK_ADMIN_USER={{ keycloak_admin_user | default('admin') }}
KEYCLOAK_ADMIN_PASSWORD={{ keycloak_admin_password | default('CHANGE_ME_IN_VAULT') }}

# Keycloak Bootstrap (used by Keycloak container)
KC_BOOTSTRAP_ADMIN_USERNAME={{ keycloak_admin_user | default('admin') }}
KC_BOOTSTRAP_ADMIN_PASSWORD={{ keycloak_admin_password | default('CHANGE_ME_IN_VAULT') }}

# Keycloak Database
KC_DB_PASSWORD={{ keycloak_db_password | default('CHANGE_ME_IN_VAULT') }}
KC_DB_HOST={{ keycloak_db_host | default('127.0.0.1') }}
KC_DB_PORT={{ keycloak_db_port | default(5432) }}
KC_DB_NAME={{ keycloak_db_name | default('keycloak') }}
