# IacGenie Unified Infrastructure
# Generated by Ansible — do not edit manually
# Usage: cd /home/mkanavi/docker/iacgenie && docker compose up -d
---
services:
  # =====================
  # PostgreSQL 15
  # =====================
  postgres:
    image: postgres:15-alpine
    container_name: iacgenie_postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: lightsrp
      POSTGRES_PASSWORD: "${PG_ROOT_PASSWORD}"
      POSTGRES_DB: lightsrp
    volumes:
      - /home/mkanavi/docker/iacgenie/data/postgres:/var/lib/postgresql/data
    ports:
      - "127.0.0.1:5432:5432"
    networks:
      - iacgenie-backend
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U lightsrp -d lightsrp"]
      interval: 30s
      timeout: 10s
      retries: 3
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    deploy:
      resources:
        limits:
          cpus: '0.75'
          memory: '2g'

  # =====================
  # Redis 7
  # =====================
  redis:
    image: redis:7-alpine
    container_name: iacgenie_redis
    restart: unless-stopped
    command: redis-server --appendonly yes --maxmemory {{ service_memory_defaults.redis | default('512m') }} --maxmemory-policy allkeys-lru
    volumes:
      - /home/mkanavi/docker/iacgenie/data/redis:/data
    ports:
      - "127.0.0.1:6379:6379"
    networks:
      - iacgenie-backend
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 30s
      timeout: 10s
      retries: 3
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: '512m'

  # =====================
  # MinIO (pinned for reproducibility)
  # =====================
  minio:
    image: minio/minio:latest
    container_name: iacgenie_minio
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: "{{ minio_root_user | default('iacgenie') }}"
      MINIO_ROOT_PASSWORD: "${MINIO_ROOT_PASSWORD}"
    volumes:
      - /home/mkanavi/docker/iacgenie/data/minio:/data
    ports:
      - "127.0.0.1:9000:9000"
    networks:
      - iacgenie-backend
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 30s
      timeout: 10s
      retries: 3
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: '4g'

  # MinIO Console — proxied via Nginx with auth for admin access only
  minio-console:
    image: nginx:1.27-alpine
    container_name: iacgenie_minio_console_proxy
    restart: unless-stopped
    ports:
      - "127.0.0.1:9001:9001"
    networks:
      - iacgenie-frontend
      - iacgenie-backend
    depends_on:
      - minio
    volumes:
      - ./minio-nginx.conf:/etc/nginx/conf.d/default.conf:ro
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: '256m'

  # =====================
  # OpenBao 2.6.0
  # =====================
  openbao:
    image: openbao/openbao:2.6.0
    container_name: iacgenie_openbao
    restart: unless-stopped
    command: bao server -config=/openbao/storage/openbao-prod.hcl
    user: "0:0"  # Run as root to match bind mount ownership
    environment:
      OPENBAO_ADDR: http://127.0.0.1:8200
      OPENBAO_CLUSTER_ADDR: http://127.0.0.1:8201
      OPENBAO_UI: "true"
      OPENBAO_LOG_LEVEL: info
    volumes:
      - /home/mkanavi/docker/iacgenie/data/openbao:/openbao/storage
      - /home/mkanavi/docker/iacgenie/data/openbao_raft:/openbao/raft
      - /etc/letsencrypt:/etc/letsencrypt
    ports:
      - "127.0.0.1:8200:8200"
      - "127.0.0.1:8201:8201"
    networks:
      - iacgenie-backend
    healthcheck:
      test: ["/usr/bin/bao", "status", "--address", "http://127.0.0.1:8200"]
      interval: 30s
      timeout: 10s
      retries: 3
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: '1g'

  # =====================
  # Keycloak 26.0
  # =====================
  keycloak:
    image: quay.io/keycloak/keycloak:26.0
    container_name: iacgenie_keycloak
    restart: unless-stopped
    command:
      - start
      - --http-enabled=true
      - --http-port=8080
      - --db=postgres
      - --import-realm
      - --hostname=https://auth.iacgenie.com
      - --hostname-admin=https://auth.iacgenie.com
      - --hostname-strict=false
    environment:
      KC_BOOTSTRAP_ADMIN_USERNAME: "${KEYCLOAK_ADMIN_USER}"
      KC_BOOTSTRAP_ADMIN_PASSWORD: "${KEYCLOAK_ADMIN_PASSWORD}"
      KEYCLOAK_ADMIN: "${KEYCLOAK_ADMIN_USER}"
      KEYCLOAK_ADMIN_PASSWORD: "${KEYCLOAK_ADMIN_PASSWORD}"
      KC_DB_PASSWORD: "${KC_DB_PASSWORD}"
    volumes:
      - /home/mkanavi/docker/iacgenie/data/keycloak:/opt/keycloak/data
      - ./keycloak.conf:/opt/keycloak/conf/keycloak.conf:ro
    ports:
      - "127.0.0.1:8083:8080"
    networks:
      - iacgenie-backend
    depends_on:
      - postgres
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'exec 6<>/dev/tcp/127.0.0.1/8080 && exec 6>&-']
      interval: 30s
      timeout: 10s
      retries: 3
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: '2g'

  # =====================
  # Gitea 1.23.4 (SQLite)
  # =====================
  gitea:
    image: gitea/gitea:1.23.4-rootless
    container_name: iacgenie_gitea
    restart: unless-stopped
    environment:
      USER: root
      GITEA__database__DB_TYPE: sqlite3
      GITEA__database__CONN_STRING: /var/lib/gitea/gitea.db
      GITEA__admin__INIT_ROOT_USER_NAME: "${GITEA_ADMIN_USERNAME:-admin}"
      GITEA__admin__INIT_ROOT_USER_PASSWORD: "${GITEA_ADMIN_PASSWORD}"
      GITEA__security__INSTALL_LOCK: "true"
      GITEA__security__DISABLE_REGISTRATION: "true"
      GITEA__service__DISABLE_REGISTRATION: "true"
      GITEA__service__REGISTER_EMAIL_CONFIRM: "false"
      GITEA__service__ENABLE_NOTIFY_MAIL: "{{ gitea_enable_notify_mail | default('true') }}"
      GITEA__mailer__ENABLED: "{{ gitea_enable_notify_mail | default('true') }}"
      GITEA__mailer__SMTP_ADDR: "{{ smtp_addr | default('mail.smtp2go.com') }}"
      GITEA__mailer__SMTP_PORT: "{{ smtp_port | default('2525') }}"
      GITEA__mailer__USER: "{{ smtp_user | default('CHANGE_ME_IN_VAULT') }}"
      GITEA__mailer__PASSWD: "{{ smtp_pass | default('CHANGE_ME_IN_VAULT') }}"
      GITEA__mailer__FROM: "{{ smtp_from | default('noreply@iacgenie.com') }}"
      GITEA__security__DISABLE_GRAVATAR: "true"
      GITEA__security__ENABLE_CAPTCHA: "true"
      GITEA__security__MIN_PASSWORD_LENGTH: 12
      # 2FA enforcement (Phase 10.9)
      GITEA__security__DEFAULT_ENABLE_2FA: "{{ gitea_2fa_enforce | default('true') }}"
      GITEA__session__SESSION_LIFETIME: 86400
      GITEA__session__COOKIE_SECURE: "true"
      GITEA__security__DEFAULT_ENABLE_QUOTAS: "false"
      GITEA__api__ENABLE_SWAGGER: "true"
    volumes:
      - /home/mkanavi/docker/iacgenie/data/gitea:/var/lib/gitea
      - /home/mkanavi/docker/iacgenie/data/gitea:/etc/gitea
    ports:
      - "127.0.0.1:3000:3000"
      - "127.0.0.1:2222:2222"
    networks:
      - iacgenie-backend
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:3000/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: '1g'

  # =====================
  # LightSerp API
  # =====================
  lightserp-api:
    image: lightserp-lightserp-api:latest
    container_name: iacgenie_lightserp_api
    restart: unless-stopped
    environment:
      LOGTIDE_URL: http://localhost:4318/v1/traces
      MINIO_ENDPOINT: "minio:9000"
      MINIO_ACCESS_KEY: "${MINIO_ROOT_USER}"
      MINIO_SECRET_KEY: "${MINIO_ROOT_PASSWORD}"
      NSQD_ADDR: "nsqd:4150"
      LIGHTSERP_PAGEZEN_API: "http://pagezen:8082"
      SEARXNG_URL: "http://searxng:8080"
      LIGHTSERP_S3_BASE: "iacgenie-lightserp"
      LIGHTSERP_ALLOW_INSECURE: "true"
      REDIS_URL: "redis://:${REDIS_PASSWORD}@redis:6379/0"
      LIGHTSERP_API_SECRET: "${LIGHTSERP_API_SECRET}"
      LIGHTSERP_DATABASE_URL: "${LIGHTSERP_DATABASE_URL}"
      LIGHTSERP_KEYCLOAK_CLIENT_SECRET: "${LIGHTSERP_KEYCLOAK_CLIENT_SECRET}"
    ports:
      - "127.0.0.1:8000:3000"
      - "127.0.0.1:3071:3000"
    networks:
      - iacgenie-frontend
      - iacgenie-backend
      - iacgenie-messaging
    depends_on:
      - minio
      - nsqd
      - searxng
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: '512m'
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

  # =====================
  # LightSerp WebUI
  # =====================
  lightserp-webui:
    image: lightserp-lightserp-webui:latest
    container_name: iacgenie_lightserp_webui
    restart: unless-stopped
    ports:
      - "127.0.0.1:3001:3070"
    networks:
      - iacgenie-frontend
    depends_on:
      - lightserp-api
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: '512m'
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

  # =====================
  # SearXNG (pinned for reproducibility)
  # =====================
  searxng:
    image: searxng/searxng:latest
    container_name: iacgenie_searxng
    restart: unless-stopped
    environment:
      SEARXNG_SECRET: "${SEARXNG_SECRET_KEY}"
      SEARXNG_BASE_URL: "http://search.iacgenie.com"
    ports:
      - "127.0.0.1:8082:8080"
    networks:
      - iacgenie-frontend
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:8080/"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: '512m'
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

  # =====================
  # NSQD (pinned for reproducibility)
  # =====================
  nsqd:
    image: nsqio/nsq:latest
    container_name: iacgenie_nsqd
    restart: unless-stopped
    command: nsqd --data-path=/nsq/data
    volumes:
      - /home/mkanavi/docker/iacgenie/data/nsqd:/nsq/data
    ports:
      - "127.0.0.1:4150:4150"
      - "127.0.0.1:4151:4151"
    networks:
      - iacgenie-messaging
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:4151/stats 2>/dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: '256m'
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

  # =====================
  # PageZen
  # =====================
  pagezen:
    image: lightserp-pagezen:latest
    container_name: iacgenie_pagezen
    restart: unless-stopped
    environment:
      LIGHTSERP_API_URL: "http://lightserp-api:8000"
      LIGHTSERP_API_SECRET: "${LIGHTSERP_API_SECRET}"
    ports:
      - "127.0.0.1:8081:8082"
    networks:
      - iacgenie-frontend
    depends_on:
      - lightserp-api
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: '512m'
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

  # =====================
  # IacGenie Platform Backend (API)
  # =====================
  iacgenie-backend:
    image: iacgenie-backend:latest
    container_name: iacgenie_backend
    restart: unless-stopped
    environment:
      KC_BOOTSTRAP_ADMIN_USERNAME: "${KEYCLOAK_ADMIN_USER}"
      KC_BOOTSTRAP_ADMIN_PASSWORD: "${KEYCLOAK_ADMIN_PASSWORD}"
      DATABASE_URL: "postgresql://lightsrp:***@postgres:5432/iacgenie"
      REDIS_URL: "redis://:${REDIS_PASSWORD}@redis:6379/0"
      MINIO_ENDPOINT: "minio:9000"
      MINIO_ACCESS_KEY: "${MINIO_ROOT_USER}"
      MINIO_SECRET_KEY: "${MINIO_ROOT_PASSWORD}"
      NSQD_ADDR: "nsqd:4150"
      OPENBAO_ADDR: "http://openbao:8200"
      KEYCLOAK_URL: "http://keycloak:8080"
      KEYCLOAK_REALM: "iacgenie"
      KEYCLOAK_CLIENT_ID: "iacgenie-platform"
      JWT_SECRET: "${IACGENIE_JWT_SECRET}"
      APP_ENV: "production"
    ports:
      - "127.0.0.1:3003:8000"
    networks:
      - iacgenie-backend
    depends_on:
      - postgres
      - minio
      - redis
      - nsqd
      - openbao
      - keycloak
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: '512m'
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

  # =====================
  # IacGenie Platform Frontend (UI)
  # =====================
  iacgenie-frontend:
    image: iacgenie-frontend:latest
    container_name: iacgenie_frontend
    restart: unless-stopped
    environment:
      NEXT_PUBLIC_API_URL: "http://127.0.0.1:3003"
      NEXT_PUBLIC_PLATFORM_URL: "https://platform.iacgenie.com"
    ports:
      - "127.0.0.1:3002:80"
    networks:
      - iacgenie-frontend
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: '512m'
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

  # =====================
  # Grafana (monitoring)
  # =====================
  grafana:
    image: grafana/grafana:latest
    container_name: iacgenie_grafana
    restart: unless-stopped
    environment:
      GF_SERVER_ROOT_URL: "http://localhost:3004"
      GF_USERS_ALLOW_SIGN_UP: "false"
    ports:
      - "127.0.0.1:3004:3000"
    volumes:
      - /home/mkanavi/docker/iacgenie/data/grafana:/var/lib/grafana
    networks:
      - iacgenie-frontend
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: '512m'
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

  # =====================
  # Prometheus (monitoring)
  # =====================
  prometheus:
    image: prom/prometheus:latest
    container_name: iacgenie_prometheus
    restart: unless-stopped
    volumes:
      - /home/mkanavi/docker/iacgenie/data/prometheus:/prometheus
    ports:
      - "127.0.0.1:9090:9090"
    networks:
      - iacgenie-frontend
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: '1g'
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

  # =====================
  # Cloudflared (tunnel)
  # =====================
  cloudflared:
    image: cloudflare/cloudflared:latest
    container_name: iacgenie_cloudflared
    restart: unless-stopped
    command: tunnel --no-autoupdate run
    environment:
      TUNNEL_TOKEN: "${CLOUDFLARE_TUNNEL_TOKEN}"
    networks:
      - iacgenie-frontend
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: '256m'
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

  # =====================
  # ClamAV Web Client (port-shifted for auth-wrapper)
  # =====================
  clamav-backend:
    image: rguziy/clamav-web-client:latest
    container_name: iacgenie_clamav
    restart: unless-stopped
    ports:
      - "127.0.0.1:9091:80"
    networks:
      - iacgenie-frontend
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: '512m'
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

  # =====================
  # CrowdSec Backend (port-shifted for auth-wrapper)
  # =====================
  crowdsec-backend:
    image: crowdsecurity/crowdsec:latest
    container_name: iacgenie_crowdsec
    restart: unless-stopped
    ports:
      - "127.0.0.1:3030:8080"
    networks:
      - iacgenie-frontend
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: '512m'
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

  # =====================
  # PageGen Backend (port-shifted for auth-wrapper)
  # =====================
  pagegen-backend:
    image: lightserp-pagegen:latest
    container_name: iacgenie_pagegen
    restart: unless-stopped
    ports:
      - "127.0.0.1:3032:8082"
    networks:
      - iacgenie-frontend
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: '512m'
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

  # =====================
  # SearXNG Backend (port-shifted for auth-wrapper)
  # =====================
  searxng-backend:
    image: searxng/searxng:latest
    container_name: iacgenie_searxng_backend
    restart: unless-stopped
    ports:
      - "127.0.0.1:8084:8080"
    networks:
      - iacgenie-frontend
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: '512m'
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

  # =====================
  # Auth Wrapper — Shared OIDC gateway for clamav, pagegen, crowdsec, searxng
  # Routes to backend based on Host header via DOMAIN_BACKEND_MAP
  # =====================
  auth-wrapper:
    build:
      context: ../shared-auth-wrapper/auth_wrapper2
      dockerfile: Dockerfile
    image: iacgenie/auth-wrapper:latest
    container_name: iacgenie_auth_wrapper
    restart: unless-stopped
    environment:
      PORT: "9096"
      KEYCLOAK_URL: "{{ keycloak_url }}"
      KEYCLOAK_REALM: "iacgenie"
      KEYCLOAK_CLIENT_ID: "auth-wrapper"
      KEYCLOAK_CLIENT_SECRET: "${AUTH_WRAPPER_KC_SECRET}"
      SESSION_SECRET: "${AUTH_WRAPPER_SESSION_SECRET}"
      SERVICE_NAME: "Auth-Wrapper"
      SERVICE_TITLE: "IaCGenie Services"
      SERVICE_BACKENDS: "clamav:9091,pagegen:3032,crowdsec:3030,searxng:8084,default:9090"
    ports:
      - "{{ auth_wrapper_host_port }}:9096"
    networks:
      - iacgenie-frontend
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: '256m'
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

# =====================
# Docker Network Segmentation (Phase 10.7)
# =====================
networks:
  # Frontend: nginx-exposed services
  iacgenie-frontend:
    driver: bridge
  # Backend: database, cache, object storage, auth
  iacgenie-backend:
    driver: bridge
  # Messaging: pub/sub services
  iacgenie-messaging:
    driver: bridge

# NOTE: This template is generated by Ansible.
# All variables come from group_vars/all.yml (ANSIBLE_VAULT encrypted).
# No secrets are hardcoded — they are fetched from OpenBao at deploy time.
