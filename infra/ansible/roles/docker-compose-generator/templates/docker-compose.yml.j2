# IacGenie Unified Infrastructure
# Generated by Ansible — do not edit manually
# Usage: cd /home/mkanavi/docker/iacgenie && docker compose up -d
---
services:
  # =====================
  # PostgreSQL 15
  # =====================
  postgres:
    image: postgres:15-alpine
    container_name: iacgenie_postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: lightsrp
      POSTGRES_PASSWORD: "${PG_ROOT_PASSWORD}"
      POSTGRES_DB: lightsrp
    volumes:
      - /home/mkanavi/docker/iacgenie/data/postgres:/var/lib/postgresql/data
    ports:
      - "127.0.0.1:5432:5432"
    networks:
      - iacgenie-backend
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U lightsrp -d lightsrp"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.postgres }}"

  # =====================
  # Redis 7
  # =====================
  redis:
    image: redis:7-alpine
    container_name: iacgenie_redis
    restart: unless-stopped
    command: redis-server --appendonly yes --maxmemory {{ service_memory_defaults.redis | default('512m') }} --maxmemory-policy allkeys-lru
    volumes:
      - /home/mkanavi/docker/iacgenie/data/redis:/data
    ports:
      - "127.0.0.1:6379:6379"
    networks:
      - iacgenie-backend
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.redis }}"

  # =====================
  # MinIO (pinned for reproducibility)
  # =====================
  minio:
    image: minio/minio:latest
    container_name: iacgenie_minio
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: "{{ minio_root_user | default('iacgenie') }}"
      MINIO_ROOT_PASSWORD: "${MINIO_ROOT_PASSWORD}"
    volumes:
      - /home/mkanavi/docker/iacgenie/data/minio:/data
    ports:
      - "127.0.0.1:9000:9000"
    networks:
      - iacgenie-backend
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.minio }}"

  # MinIO Console — proxied via Nginx with auth for admin access only
  minio-console:
    image: nginx:1.27-alpine
    container_name: iacgenie_minio_console_proxy
    restart: unless-stopped
    ports:
      - "127.0.0.1:9001:9001"
    networks:
      - iacgenie-frontend
    depends_on:
      - minio
    volumes:
      - ./minio-nginx.conf:/etc/nginx/conf.d/default.conf:ro

  # =====================
  # OpenBao 2.6.0
  # =====================
  openbao:
    image: openbao/openbao:2.6.0
    container_name: iacgenie_openbao
    restart: unless-stopped
    user: "0:0"
    command: bao server -config=/openbao/storage/openbao-prod.hcl
    environment:
      OPENBAO_ADDR: http://127.0.0.1:8200
      OPENBAO_CLUSTER_ADDR: http://127.0.0.1:8201
      OPENBAO_UI: "true"
      OPENBAO_STORAGE_TYPE: raft
      OPENBAO_STORAGE_PATH: /openbao/storage
      OPENBAO_LOG_LEVEL: info
    volumes:
      - /home/mkanavi/docker/iacgenie/data/openbao:/openbao/storage
      - /home/mkanavi/docker/iacgenie/data/openbao_raft:/openbao/raft
      - /etc/letsencrypt:/etc/letsencrypt
    ports:
      - "127.0.0.1:8200:8200"
      - "127.0.0.1:8201:8201"
    networks:
      - iacgenie-backend
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O - http://127.0.0.1:8200/v1/sys/health | grep -q '\"sealed\":false'"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.openbao }}"

  # =====================
  # Keycloak 26.0
  # =====================
  keycloak:
    image: quay.io/keycloak/keycloak:26.0
    container_name: iacgenie_keycloak
    restart: unless-stopped
    command:
      - start
      - --http-enabled=true
      - --http-port=8080
      - --db-url-host=postgres
      - --db-url-port=5432
      - --db-url-database=keycloak
      - --db-username=keycloak
      - --db-password=${KC_DB_PASSWORD}
      - --hostname=https://auth.iacgenie.com
      - --hostname-admin=https://auth.iacgenie.com
    environment:
      KC_BOOTSTRAP_ADMIN_USERNAME: "${KEYCLOAK_ADMIN_USER}"
      KC_BOOTSTRAP_ADMIN_PASSWORD: "${KEYCLOAK_ADMIN_PASSWORD}"
      KEYCLOAK_ADMIN: "${KEYCLOAK_ADMIN_USER}"
      KEYCLOAK_ADMIN_PASSWORD: "${KEYCLOAK_ADMIN_PASSWORD}"
      KC_DB_PASSWORD: "${KC_DB_PASSWORD}"
      KC_DB_HOST: "${KC_DB_HOST}"
      KC_DB_PORT: "${KC_DB_PORT}"
      KC_DB_NAME: "${KC_DB_NAME}"
    volumes:
      - /home/mkanavi/docker/iacgenie/data/keycloak:/opt/keycloak/data
    ports:
      - "127.0.0.1:8083:8080"
    networks:
      - iacgenie-backend
    depends_on:
      - postgres
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1/8080 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.keycloak }}"

  # =====================
  # Gitea 1.23.4
  # =====================
  gitea:
    image: gitea/gitea:1.23.4-rootless
    container_name: iacgenie_gitea
    restart: unless-stopped
    environment:
      USER: root
      GITEA__database__DB_TYPE: postgres
      GITEA__database__HOST: postgres:5432
      GITEA__database__NAME: gitea
      GITEA__database__USER: gitea
      GITEA__database__PASSWORD: "${GITEA_DB_PASSWORD}"
      GITEA__admin__INIT_ROOT_USER_NAME: "${GITEA_ADMIN_USERNAME:-admin}"
      GITEA__admin__INIT_ROOT_USER_PASSWORD: "${GITEA_ADMIN_PASSWORD}"
      GITEA__security__INSTALL_LOCK: "true"
      GITEA__security__DISABLE_REGISTRATION: "true"
      GITEA__service__DISABLE_REGISTRATION: "true"
      GITEA__service__REGISTER_EMAIL_CONFIRM: "false"
      GITEA__service__ENABLE_NOTIFY_MAIL: "{{ gitea_enable_notify_mail | default('true') }}"
      GITEA__mailer__ENABLED: "{{ gitea_enable_notify_mail | default('true') }}"
      GITEA__mailer__SMTP_ADDR: "{{ smtp_addr | default('mail.smtp2go.com') }}"
      GITEA__mailer__SMTP_PORT: "{{ smtp_port | default('2525') }}"
      GITEA__mailer__USER: "{{ smtp_user | default('CHANGE_ME_IN_VAULT') }}"
      GITEA__mailer__PASSWD: "{{ smtp_pass | default('CHANGE_ME_IN_VAULT') }}"
      GITEA__mailer__FROM: "{{ smtp_from | default('noreply@iacgenie.com') }}"
      GITEA__security__DISABLE_GRAVATAR: "true"
      GITEA__security__ENABLE_CAPTCHA: "true"
      GITEA__security__MIN_PASSWORD_LENGTH: 12
      # 2FA enforcement (Phase 10.9)
      GITEA__security__DEFAULT_ENABLE_2FA: "{{ gitea_2fa_enforce | default('true') }}"
      GITEA__session__SESSION_LIFETIME: 86400
      GITEA__session__COOKIE_SECURE: "true"
      GITEA__security__DEFAULT_ENABLE_QUOTAS: "false"
      GITEA__api__ENABLE_SWAGGER: "true"
    volumes:
      - /home/mkanavi/docker/iacgenie/data/gitea:/var/lib/gitea
      - /home/mkanavi/docker/iacgenie/data/gitea:/etc/gitea
    ports:
      - "127.0.0.1:3000:3000"
      - "127.0.0.1:2222:2222"
    networks:
      - iacgenie-backend
    depends_on:
      - postgres
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1/3000 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.gitea }}"

  # =====================
  # LightSerp API
  # =====================
  lightserp-api:
    image: lightserp-lightserp-api:latest
    container_name: iacgenie_lightserp_api
    restart: unless-stopped
    environment:
      LOGTIDE_URL: http://localhost:4318/v1/traces
      MINIO_ENDPOINT: "minio:9000"
      MINIO_ACCESS_KEY: "${MINIO_ROOT_USER}"
      MINIO_SECRET_KEY: "${MINIO_ROOT_PASSWORD}"
      NSQD_ADDR: "nsqd:4150"
      LIGHTSERP_PAGEZEN_API: "http://pagezen:8082"
      SEARXNG_URL: "http://searxng:8080"
      LIGHTSERP_S3_BASE: "iacgenie-lightserp"
      LIGHTSERP_ALLOW_INSECURE: "true"
      REDIS_URL: "redis://:${REDIS_PASSWORD}@redis:6379/0"
      LIGHTSERP_API_SECRET: "${LIGHTSERP_API_SECRET}"
      LIGHTSERP_DATABASE_URL: "${LIGHTSERP_DATABASE_URL}"
      LIGHTSERP_KEYCLOAK_CLIENT_SECRET: "${LIGHTSERP_KEYCLOAK_CLIENT_SECRET}"
    ports:
      - "127.0.0.1:8000:3000"
    networks:
      - iacgenie-frontend
      - iacgenie-backend
      - iacgenie-messaging
    depends_on:
      - postgres
      - minio
      - nsqd
      - searxng
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.lightserp }}"

  # =====================
  # LightSerp WebUI
  # =====================
  lightserp-webui:
    image: lightserp-lightserp-webui:latest
    container_name: iacgenie_lightserp_webui
    restart: unless-stopped
    ports:
      - "127.0.0.1:3001:3070"
    networks:
      - iacgenie-frontend
    depends_on:
      - lightserp-api
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.lightserp }}"

  # =====================
  # SearXNG (pinned for reproducibility)
  # =====================
  searxng:
    image: searxng/searxng:latest
    container_name: iacgenie_searxng
    restart: unless-stopped
    environment:
      SEARXNG_SECRET: "${SEARXNG_SECRET_KEY}"
      SEARXNG_BASE_URL: "http://search.iacgenie.com"
    ports:
      - "127.0.0.1:8082:8080"
    networks:
      - iacgenie-frontend
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:8080/"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "512m"

  # =====================
  # NSQD (pinned for reproducibility)
  # =====================
  nsqd:
    image: nsqio/nsq:latest
    container_name: iacgenie_nsqd
    restart: unless-stopped
    command: nsqd --data-path=/nsq/data
    volumes:
      - /home/mkanavi/docker/iacgenie/data/nsqd:/nsq/data
    ports:
      - "127.0.0.1:4150:4150"
      - "127.0.0.1:4151:4151"
    networks:
      - iacgenie-messaging
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1/4150 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "256m"

  # =====================
  # PageZen
  # =====================
  pagezen:
    image: lightserp-pagezen:latest
    container_name: iacgenie_pagezen
    restart: unless-stopped
    environment:
      LIGHTSERP_API_URL: "http://lightserp-api:8000"
      LIGHTSERP_API_SECRET: "${LIGHTSERP_API_SECRET}"
    ports:
      - "127.0.0.1:8081:8082"
    networks:
      - iacgenie-frontend
    depends_on:
      - lightserp-api
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.pagezen }}"

# =====================
# Docker Network Segmentation (Phase 10.7)
# =====================
networks:
  # Frontend: nginx-exposed services
  iacgenie-frontend:
    driver: bridge
  # Backend: database, cache, object storage, auth
  iacgenie-backend:
    driver: bridge
  # Messaging: pub/sub services
  iacgenie-messaging:
    driver: bridge
