# IacGenie Unified Infrastructure
# Generated by Ansible — do not edit manually
# All secrets sourced from unified .env file (fetched from OpenBao at runtime)
# Usage: cd /home/mkanavi/docker/iacgenie && docker compose up -d
---
services:
  # =====================
  # PostgreSQL 15
  # =====================
  postgres:
    image: postgres:15-alpine
    container_name: iacgenie_postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: "${POSTGRES_USER}"
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}"
      POSTGRES_DB: "${POSTGRES_DB}"
    volumes:
      - /home/mkanavi/docker/iacgenie/data/postgres:/var/lib/postgresql/data
    ports:
      - "127.0.0.1:5432:5432"

    networks:
      - iacgenie-backend
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 30s
      timeout: 10s
      retries: 3
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    deploy:
      resources:
        limits:
          cpus: "{{ service_cpu_defaults.postgres | default('0.75') }}"
          memory: "{{ service_memory_defaults.postgres | default('2g') }}"

  # =====================
  # Redis 7
  # =====================
  redis:
    image: redis:7-alpine
    container_name: iacgenie_redis
    restart: unless-stopped
    command: redis-server --appendonly yes --maxmemory {{ service_memory_defaults.redis | default('512m') }} --maxmemory-policy allkeys-lru --requirepass ${REDIS_PASSWORD}
    volumes:
      - /home/mkanavi/docker/iacgenie/data/redis:/data
    ports:
      - "127.0.0.1:6379:6379"

    networks:
      - iacgenie-backend
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD}", "ping"]
      interval: 30s
      timeout: 10s
      retries: 3
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    deploy:
      resources:
        limits:
          cpus: "{{ service_cpu_defaults.redis | default('0.25') }}"
          memory: "{{ service_memory_defaults.redis | default('512m') }}"

  # =====================
  # MinIO
  # =====================
  minio:
    image: minio/minio:latest
    container_name: iacgenie_minio
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: "${MINIO_ROOT_USER}"
      MINIO_ROOT_PASSWORD: "${MINIO_ROOT_PASSWORD}"
    volumes:
      - /home/mkanavi/docker/iacgenie/data/minio:/data
    ports:
      - "127.0.0.1:9000:9000"

    networks:
      - iacgenie-backend
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 30s
      timeout: 10s
      retries: 3
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    deploy:
      resources:
        limits:
          cpus: "{{ service_cpu_defaults.minio | default('0.5') }}"
          memory: "{{ service_memory_defaults.minio | default('4g') }}"

  # MinIO Console Proxy
  minio-console:
    image: nginx:1.27-alpine
    container_name: iacgenie_minio_console_proxy
    restart: unless-stopped
    ports:
      - "127.0.0.1:9001:9001"

    networks:
      - iacgenie-frontend
    depends_on:
      - minio
    volumes:
      - ./minio-nginx.conf:/etc/nginx/conf.d/default.conf:ro
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          cpus: "{{ service_cpu_defaults.nginx | default('0.25') }}"
          memory: "{{ service_memory_defaults.nginx | default('256m') }}"

  # =====================
  # OpenBao 2.6.0
  # =====================
  # Production-ready OpenBao with Raft storage, TLS via Nginx reverse proxy.
  # Raft data at: /home/mkanavi/docker/iacgenie/openbao_raft/
  # Storage configs at: /home/mkanavi/docker/iacgenie/data/openbao/
  openbao:
    image: openbao/openbao:2.6.0
    container_name: iacgenie_openbao
    restart: unless-stopped
    user: "100:100"
    # HCL at /openbao/raft/openbao-prod.hcl, storage at /openbao/raft
    command: bao server -config=/openbao/raft/openbao-prod.hcl
    environment:
      OPENBAO_ADDR: http://127.0.0.1:8200
      OPENBAO_CLUSTER_ADDR: http://127.0.0.1:8201
      OPENBAO_UI: "true"
      OPENBAO_LOG_LEVEL: info
      BAO_SKIP_DROP_ROOT: "false"
    # FIXED: Correct volume paths — raft data lives at openbao_raft/ not data/openbao_raft/
    volumes:
      - /home/mkanavi/docker/iacgenie/openbao_raft:/openbao/raft
      - /home/mkanavi/docker/iacgenie/data/openbao:/openbao/storage
    ports:
      - "127.0.0.1:8200:8200"
      - "127.0.0.1:8201:8201"

    networks:
      - iacgenie-backend
    healthcheck:
      test: ["CMD", "/usr/bin/bao", "status", "--address", "http://127.0.0.1:8200"]
      interval: 30s
      timeout: 10s
      retries: 3
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - SETGID
      - SETUID
      - DAC_OVERRIDE
    deploy:
      resources:
        limits:
          cpus: "{{ service_cpu_defaults.openbao | default('0.5') }}"
          memory: "{{ service_memory_defaults.openbao | default('1g') }}"

  # =====================
  # Keycloak 26.0
  # =====================
  keycloak:
    image: quay.io/keycloak/keycloak:26.0
    container_name: iacgenie_keycloak
    restart: unless-stopped
    command:
      - start-prod
      - --http-enabled=true
      - --http-port=8080
      - --db=postgres
      - --import-realm
      - --hostname=https://auth.iacgenie.com
      - --hostname-admin=https://auth.iacgenie.com
      - --hostname-strict=false
    environment:
      KC_BOOTSTRAP_ADMIN_USERNAME: "${KEYCLOAK_ADMIN_USER}"
      KC_BOOTSTRAP_ADMIN_PASSWORD: "${KEYCLOAK_ADMIN_PASSWORD}"
      KC_DB_PASSWORD: "${KC_DB_PASSWORD}"
      KC_DB_HOST: "${KC_DB_HOST}"
      KC_DB_PORT: "${KC_DB_PORT}"
      KC_DB_NAME: "${KC_DB_NAME}"
    volumes:
      - /home/mkanavi/docker/iacgenie/data/keycloak:/opt/keycloak/data
    ports:
      - "127.0.0.1:8083:8080"

    networks:
      - iacgenie-backend
    depends_on:
      - postgres
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://127.0.0.1:8080/health/ready || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          cpus: "{{ service_cpu_defaults.keycloak | default('1.0') }}"
          memory: "{{ service_memory_defaults.keycloak | default('2g') }}"

  # =====================
  # Gitea 1.23.4-rootless
  # =====================
  gitea:
    image: gitea/gitea:1.23.4-rootless
    container_name: iacgenie_gitea
    restart: unless-stopped
    environment:
      # FIXED: Removed USER: root — using rootless image properly
      GITEA__database__DB_TYPE: postgres
      GITEA__database__HOST: postgres:5432
      GITEA__database__NAME: gitea
      GITEA__database__USER: gitea
      GITEA__database__PASSWORD: "${GITEA_DB_PASSWORD}"
      GITEA__admin__INIT_ROOT_USER_NAME: "${GITEA_ADMIN_USERNAME}"
      GITEA__admin__INIT_ROOT_USER_PASSWORD: "${GITEA_ADMIN_PASSWORD}"
      GITEA__security__INSTALL_LOCK: "true"
      GITEA__security__DISABLE_REGISTRATION: "{{ gitea_disable_registration | default('true') }}"
      GITEA__service__DISABLE_REGISTRATION: "{{ gitea_disable_registration | default('true') }}"
      GITEA__service__REGISTER_EMAIL_CONFIRM: "false"
      GITEA__service__ENABLE_NOTIFY_MAIL: "{{ gitea_enable_notify_mail | default('true') }}"
      GITEA__mailer__ENABLED: "{{ gitea_enable_notify_mail | default('true') }}"
      GITEA__mailer__SMTP_ADDR: "{{ smtp_addr | default('mail.smtp2go.com') }}"
      GITEA__mailer__SMTP_PORT: "{{ smtp_port | default('2525') }}"
      GITEA__mailer__USER: "{{ smtp_user | default('CHANGE_ME_IN_VAULT') }}"
      GITEA__mailer__PASSWD: "{{ smtp_pass | default('CHANGE_ME_IN_VAULT') }}"
      GITEA__mailer__FROM: "{{ smtp_from | default('noreply@iacgenie.com') }}"
      GITEA__security__DISABLE_GRAVATAR: "true"
      GITEA__security__ENABLE_CAPTCHA: "true"
      GITEA__security__MIN_PASSWORD_LENGTH: 12
      GITEA__security__DEFAULT_ENABLE_2FA: "{{ gitea_2fa_enforce | default('true') }}"
      GITEA__session__SESSION_LIFETIME: 86400
      GITEA__session__COOKIE_SECURE: "true"
      GITEA__security__DEFAULT_ENABLE_QUOTAS: "false"
      GITEA__api__ENABLE_SWAGGER: "true"
    volumes:
      - /home/mkanavi/docker/iacgenie/data/gitea:/var/lib/gitea
      - /home/mkanavi/docker/iacgenie/data/gitea/config:/etc/gitea
    ports:
      - "127.0.0.1:3000:3000"
      - "127.0.0.1:2222:2222"

    networks:
      - iacgenie-backend
    depends_on:
      - postgres
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1/3000 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 3
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          cpus: "{{ service_cpu_defaults.gitea | default('0.5') }}"
          memory: "{{ service_memory_defaults.gitea | default('1g') }}"

  # =====================
  # LightSerp API
  # =====================
  lightserp-api:
    image: lightserp-lightserp-api:latest
    container_name: iacgenie_lightserp_api
    restart: unless-stopped
    environment:
      MINIO_ENDPOINT: "minio:9000"
      MINIO_ACCESS_KEY: "${MINIO_ROOT_USER}"
      MINIO_SECRET_KEY: "${MINIO_ROOT_PASSWORD}"
      NSQD_ADDR: "nsqd:4150"
      LIGHTSERP_PAGEZEN_API: "http://pagezen:8082"
      SEARXNG_URL: "http://searxng:8080"
      LIGHTSERP_S3_BASE: "iacgenie-lightserp"
      # FIXED: SSL verification enabled
      LIGHTSERP_ALLOW_INSECURE: "false"
      REDIS_URL: "redis://:${REDIS_PASSWORD}@redis:6379/0"
      LIGHTSERP_API_SECRET: "${LIGHTSERP_API_SECRET}"
      LIGHTSERP_DATABASE_URL: "${LIGHTSERP_DATABASE_URL}"
      LIGHTSERP_KEYCLOAK_CLIENT_SECRET: "${LIGHTSERP_KEYCLOAK_CLIENT_SECRET}"
    ports:
      - "127.0.0.1:8000:3000"

    networks:
      - iacgenie-frontend
      - iacgenie-backend
      - iacgenie-messaging
    depends_on:
      - postgres
      - minio
      - nsqd
      - searxng
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          cpus: "{{ service_cpu_defaults.lightserp | default('1.0') }}"
          memory: "{{ service_memory_defaults.lightserp | default('512m') }}"

  # =====================
  # LightSerp WebUI
  # =====================
  lightserp-webui:
    image: lightserp-lightserp-webui:latest
    container_name: iacgenie_lightserp_webui
    restart: unless-stopped
    ports:
      - "127.0.0.1:3001:3070"

    networks:
      - iacgenie-frontend
    depends_on:
      - lightserp-api
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          cpus: "{{ service_cpu_defaults.lightserp | default('0.25') }}"
          memory: "{{ service_memory_defaults.lightserp | default('512m') }}"

  # =====================
  # SearXNG
  # =====================
  searxng:
    image: searxng/searxng:latest
    container_name: iacgenie_searxng
    restart: unless-stopped
    environment:
      SEARXNG_SECRET: "${SEARXNG_SECRET_KEY}"
      SEARXNG_BASE_URL: "http://search.iacgenie.com"
    ports:
      - "127.0.0.1:8082:8080"
    volumes:
      - /home/mkanavi/docker/iacgenie/data/searxng:/etc/searxng

    networks:
      - iacgenie-frontend
    healthcheck:
      # FIXED: Healthcheck targets the actual internal container port 8080
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:8080/"]
      interval: 30s
      timeout: 10s
      retries: 3
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: "512m"

  # =====================
  # NSQD
  # =====================
  nsqd:
    image: nsqio/nsq:latest
    container_name: iacgenie_nsqd
    restart: unless-stopped
    command: nsqd --data-path=/nsq/data
    volumes:
      - /home/mkanavi/docker/iacgenie/data/nsqd:/nsq/data
    ports:
      - "127.0.0.1:4150:4150"
      - "127.0.0.1:4151:4151"

    networks:
      - iacgenie-messaging
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1/4150 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 3
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: "256m"

  # =====================
  # PageZen
  # =====================
  pagezen:
    image: lightserp-pagezen:latest
    container_name: iacgenie_pagezen
    restart: unless-stopped
    environment:
      LIGHTSERP_API_URL: "http://lightserp-api:8000"
      LIGHTSERP_API_SECRET: "${LIGHTSERP_API_SECRET}"
    ports:
      - "127.0.0.1:8081:8082"

    networks:
      - iacgenie-frontend
    depends_on:
      - lightserp-api
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          cpus: "{{ service_cpu_defaults.pagezen | default('0.25') }}"
          memory: "{{ service_memory_defaults.pagezen | default('512m') }}"

  # =====================
  # IacGenie Platform Backend
  # =====================
  iacgenie-backend:
    image: iacgenie-backend:latest
    container_name: iacgenie_backend
    restart: unless-stopped
    environment:
      KEYCLOAK_URL: "http://keycloak:8080"
      KEYCLOAK_REALM: iacgenie
      KEYCLOAK_CLIENT_ID: iacgenie-platform
      DATABASE_URL: "${DATABASE_URL}"
      REDIS_URL: "redis://:${REDIS_PASSWORD}@redis:6379/0"
      MINIO_ENDPOINT: "minio:9000"
      MINIO_ACCESS_KEY: "${MINIO_ROOT_USER}"
      MINIO_SECRET_KEY: "${MINIO_ROOT_PASSWORD}"
      NSQD_ADDR: "nsqd:4150"
      OPENBAO_ADDR: "http://openbao:8200"
      JWT_SECRET: "${IACGENIE_JWT_SECRET}"
      APP_ENV: "production"
    ports:
      - "127.0.0.1:3003:8000"

    networks:
      - iacgenie-backend
    depends_on:
      - postgres
      - minio
      - redis
      - nsqd
      - openbao
      - keycloak
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          cpus: "0.5"
          memory: "512m"

  # =====================
  # IacGenie Platform Frontend
  # =====================
  iacgenie-frontend:
    image: iacgenie-frontend:latest
    container_name: iacgenie_frontend
    restart: unless-stopped
    environment:
      NEXT_PUBLIC_API_URL: "http://127.0.0.1:3003"
      NEXT_PUBLIC_PLATFORM_URL: "https://platform.iacgenie.com"
    ports:
      - "127.0.0.1:3002:80"

    networks:
      - iacgenie-frontend
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: "512m"

  # =====================
  # Grafana
  # =====================
  grafana:
    image: grafana/grafana:latest
    container_name: iacgenie_grafana
    restart: unless-stopped
    environment:
      GF_SERVER_ROOT_URL: "http://localhost:3004"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_SECURITY_ADMIN_PASSWORD: "${GRAFANA_ADMIN_PASSWORD}"
    ports:
      - "127.0.0.1:3004:3000"
    volumes:
      - /home/mkanavi/docker/iacgenie/data/grafana:/var/lib/grafana

    networks:
      - iacgenie-frontend
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
    deploy:
      resources:
        limits:
          cpus: "{{ service_cpu_defaults.grafana | default('0.25') }}"
          memory: "{{ service_memory_defaults.grafana | default('512m') }}"

  # =====================
  # Prometheus
  # =====================
  prometheus:
    image: prom/prometheus:latest
    container_name: iacgenie_prometheus
    restart: unless-stopped
    volumes:
      - /home/mkanavi/docker/iacgenie/data/prometheus:/prometheus
    ports:
      - "127.0.0.1:9090:9090"

    networks:
      - iacgenie-frontend
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    deploy:
      resources:
        limits:
          cpus: "{{ service_cpu_defaults.prometheus | default('0.5') }}"
          memory: "{{ service_memory_defaults.prometheus | default('1g') }}"

  # =====================
  # ClamAV
  # =====================
  clamav:
    image: rguziy/clamav-web-client:latest
    container_name: iacgenie_clamav
    restart: unless-stopped
    ports:
      - "127.0.0.1:9092:80"

    networks:
      - iacgenie-frontend
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: "512m"

  # =====================
  # CrowdSec
  # =====================
  crowdsec:
    image: crowdsecurity/crowdsec:latest
    container_name: iacgenie_crowdsec
    restart: unless-stopped
    volumes:
      - /var/log/nginx:/var/log/nginx:ro
      - /home/mkanavi/docker/iacgenie/data/crowdsec-db:/var/lib/crowdsec/data
      - /home/mkanavi/docker/iacgenie/data/crowdsec-config:/etc/crowdsec
    ports:
      - "127.0.0.1:3033:8080"

    networks:
      - iacgenie-frontend
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: "512m"

  # =====================
  # Auth Wrapper
  # =====================
  auth-wrapper:
    build:
      context: ../shared-auth-wrapper/auth_wrapper2
      dockerfile: Dockerfile
    image: iacgenie/auth-wrapper:latest
    container_name: iacgenie_auth_wrapper
    restart: unless-stopped
    environment:
      PORT: "9096"
      KEYCLOAK_URL: "https://auth.iacgenie.com"
      KEYCLOAK_REALM: iacgenie
      KEYCLOAK_CLIENT_ID: auth-wrapper
      KEYCLOAK_CLIENT_SECRET: "${AUTH_WRAPPER_KC_SECRET}"
      SESSION_SECRET: "${AUTH_WRAPPER_SESSION_SECRET}"
      SERVICE_NAME: "Auth-Wrapper"
      SERVICE_TITLE: "IacGenie Services"
      SERVICE_BACKENDS: "clamav:9092,pagegen:3032,crowdsec:3033,searxng:8084,default:9090"
    ports:
      - "127.0.0.1:9096:9096"

    networks:
      - iacgenie-frontend
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: "256m"

  # =====================
  # Loki
  # =====================
  loki:
    image: grafana/loki:2.9.0
    container_name: iacgenie_loki
    restart: unless-stopped
    command: -config.file=/etc/loki/local-config.yaml
    volumes:
      - /home/mkanavi/docker/iacgenie/loki:/loki
      - /home/mkanavi/docker/iacgenie/loki/loki-config.yaml:/etc/loki/local-config.yaml:ro
    ports:
      - "127.0.0.1:3100:3100"

    networks:
      - iacgenie-frontend
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          cpus: "{{ service_cpu_defaults.loki | default('0.5') }}"
          memory: "{{ service_memory_defaults.loki | default('1g') }}"

  # =====================
  # Promtail
  # =====================
  promtail:
    image: grafana/promtail:2.9.0
    container_name: iacgenie_promtail
    restart: unless-stopped
    volumes:
      - /var/log:/var/log:ro
      - /home/mkanavi/docker/iacgenie/promtail/positions:/etc/promtail
      - /home/mkanavi/docker/iacgenie/promtail/promtail-config.yaml:/etc/promtail/config.yml:ro

    networks:
      - iacgenie-frontend
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          cpus: "{{ service_cpu_defaults.nginx | default('0.25') }}"
          memory: "{{ service_memory_defaults.nginx | default('256m') }}"

# =====================
# Docker Network Segmentation
# =====================

networks:
  # Frontend: nginx-exposed services
  iacgenie-frontend:
    driver: bridge
  # Backend: database, cache, object storage, auth
  iacgenie-backend:
    driver: bridge
  # Messaging: pub/sub services
  iacgenie-messaging:
    driver: bridge
