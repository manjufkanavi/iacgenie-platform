# IacGenie Unified Infrastructure
# Generated by Ansible — do not edit manually
# Usage: cd /home/mkanavi/docker/iacgenie && docker compose up -d
---
services:
  # =====================
  # PostgreSQL 15 (hardened)
  # =====================
  postgres:
    image: postgres:15-alpine
    container_name: iacgenie_postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: lightsrp
      POSTGRES_PASSWORD: "${PG_ROOT_PASSWORD}"
      POSTGRES_DB: lightsrp
    volumes:
      - /home/mkanavi/docker/iacgenie/data/postgres:/var/lib/postgresql/data
      - ./templates/pg_hba.conf:/etc/postgresql/pg_hba.conf:ro
      - ./templates/postgresql.conf:/etc/postgresql/postgresql.conf:ro
      - ./templates/server.crt:/etc/postgresql/server.crt:ro
      - ./templates/server.key:/etc/postgresql/server.key:ro
      - ./templates/create_databases.sh:/docker-entrypoint-initdb.d/01-create-databases.sh:ro
    ports:
      - "127.0.0.1:5432:5432"
    networks:
      - iacgenie-backend
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETUID
      - SETGID
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp
      - /run/postgresql
    command: >
      postgres
      -c config_file=/etc/postgresql/postgresql.conf
      -c hba_file=/etc/postgresql/pg_hba.conf
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U lightsrp -d lightsrp"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.postgres }}"
          cpus: "2.0"
        reservations:
          memory: "1g"
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  # =====================
  # PgBouncer (Connection Pooler)
  # =====================
  pgbouncer:
    image: docker-pgbouncer/pgbouncer:latest
    container_name: iacgenie_pgbouncer
    restart: unless-stopped
    environment:
      DATABASE: lightsrp
      DATABASE_HOST: postgres
      DATABASE_PORT: 5432
      DATABASE_USER: lightsrp
      DATABASE_PASSWORD: "${PG_ROOT_PASSWORD}"
      PORT: 6432
      LISTEN_ADDR: "0.0.0.0"
      POOL_MODE: transaction
      MAX_CLIENT_CONN: 400
      DEFAULT_POOL_SIZE: 50
      MIN_POOL_SIZE: 10
      AUTH_TYPE: md5
    ports:
      - "127.0.0.1:6432:6432"
    networks:
      - iacgenie-backend
    depends_on:
      - postgres
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -p 6432 -U lightsrp"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp
    volumes:
      - /home/mkanavi/docker/iacgenie/pgbouncer:/etc/pgbouncer
    deploy:
      resources:
        limits:
          memory: "256m"
          cpus: "0.5"
        reservations:
          memory: "128m"
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"

  # =====================
  # postgres_exporter (Prometheus Metrics)
  # =====================
  postgres-exporter:
    image: prometheuscommunity/postgres-exporter:latest
    container_name: iacgenie_postgres_exporter
    restart: unless-stopped
    environment:
      DATA_SOURCE_NAME: "postgres://lightsrp:${PG_ROOT_PASSWORD}@postgres:5432/lightsrp?sslmode=require"
    ports:
      - "127.0.0.1:9187:9187"
    networks:
      - iacgenie-backend
    depends_on:
      - postgres
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1/9187 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: "128m"
          cpus: "0.25"
        reservations:
          memory: "64m"
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"

  # =====================
  # Redis 7 (hardened)
  # =====================
  redis:
    image: redis:7.2.4-alpine
    container_name: iacgenie_redis
    restart: unless-stopped
    user: "0"
    command: redis-server /etc/redis/redis.conf
    volumes:
      - {{ redis_data_dir | default('/home/mkanavi/docker/iacgenie/data/redis') }}:/data
      - ./templates/redis.conf:/etc/redis/redis.conf:ro
      - ./templates/ca.crt:/etc/redis/tls/ca.crt:ro
      - ./templates/server.crt:/etc/redis/tls/server.crt:ro
      - ./templates/server.key:/etc/redis/tls/server.key:ro
      - ./templates/ca.crt:/etc/redis/tls/ca.crt:ro
    ports:
      - "127.0.0.1:6379:6379"
      - "127.0.0.1:6380:6380"
    networks:
      - iacgenie-backend
    depends_on:
      - postgres
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a \"$REDIS_PASSWORD\" ping"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETUID
      - SETGID
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp
      - /var/run
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.redis }}"
          cpus: "0.5"
        reservations:
          memory: "256m"
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  # =====================
  # redis_exporter (Prometheus Metrics)
  # =====================
  redis-exporter:
    image: oliver006/redis_exporter:v1.53.0-alpine
    container_name: iacgenie_redis_exporter
    restart: unless-stopped
    environment:
      REDIS_ADDR: "redis://:${REDIS_PASSWORD}@redis:6379"
      REDIS_PASSWORD: "${REDIS_PASSWORD}"
      REDIS_ALIAS: "iacgenie-redis"
    ports:
      - "127.0.0.1:9188:9121"
    networks:
      - iacgenie-backend
    depends_on:
      - redis
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1/9121 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: "64m"
          cpus: "0.1"
        reservations:
          memory: "32m"
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"

  # =====================
  # MinIO (pinned for reproducibility)
  # =====================
  minio:
    image: minio/minio:RELEASE.2025-09-07T16-13-09Z
    container_name: iacgenie_minio
    restart: always
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: "{{ minio_root_user | default('iacgenie') }}"
      MINIO_ROOT_PASSWORD: "${MINIO_ROOT_PASSWORD}"
      MINIO_PROMETHEUS_AUTH_TYPE: "public"
    volumes:
      - /home/mkanavi/docker/iacgenie/data/minio:/data
    ports:
      - "127.0.0.1:9000:9000"
      - "127.0.0.1:9001:9001"
    networks:
      - iacgenie-backend
    healthcheck:
      test: ["CMD-SHELL", "mc ready local && curl -f http://127.0.0.1:9000/minio/health/live || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.minio }}"
          cpus: "{{ service_cpu_defaults.minio | default('2.0') }}"
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  # =====================
  # Nginx Reverse Proxy (TLS termination) — Docker container, network_mode: host
  # Config generated by nginx-container Ansible role into /home/mkanavi/docker/iacgenie/nginx/
  # =====================
  nginx:
    image: nginx:1.27-alpine
    container_name: iacgenie-nginx
    restart: always
    network_mode: host
    volumes:
      - /etc/letsencrypt:/etc/letsencrypt:ro
      - /home/mkanavi/docker/iacgenie/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - /home/mkanavi/docker/iacgenie/nginx/conf.d:/etc/nginx/conf.d:ro
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  # =====================

  # =====================
  # Cloudflare Tunnel (cloudflared container)
  # =====================
  cloudflared:
    image: cloudflare/cloudflared:2025.6.0
    container_name: iacgenie_cloudflared
    restart: always
    command: tunnel --no-autoupdate --credentials-file /etc/cloudflared/{{ cloudflared_tunnel_name }}.json run {{ cloudflared_tunnel_uuid | default(cloudflared_tunnel_name) }}
    volumes:
      - /etc/cloudflared:/etc/cloudflared:ro
      - /home/mkanavi/.cloudflared:/home/cloudflared/.cloudflared:ro
    networks:
      - iacgenie-frontend
    deploy:
      resources:
        limits:
          memory: "256m"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"
  # OpenBao 2.6.0
  # =====================
  openbao:
    image: openbao/openbao:2.6.0
    container_name: iacgenie_openbao
    restart: always
    network_mode: host
    user: "1000:1000"
    command: bao server -config=/openbao/storage/openbao-prod.hcl
    environment:
      OPENBAO_ADDR: http://127.0.0.1:8200
      OPENBAO_CLUSTER_ADDR: http://127.0.0.1:8201
      OPENBAO_UI: "true"
      OPENBAO_LOG_LEVEL: info
    volumes:
      - /home/mkanavi/docker/iacgenie/openbao_raft:/openbao/raft
      - /home/mkanavi/docker/iacgenie/data/openbao:/openbao/storage
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1/8200 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "1g"
          cpus: "1.0"
        reservations:
          memory: "512m"
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - SETUID
      - SETGID
    security_opt:
      - no-new-privileges:true
    stop_signal: SIGTERM
    stop_grace_period: 30s
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  # =====================
  # Keycloak 26.0 (PostgreSQL driver baked in)
  # =====================
  keycloak:
    image: quay.io/keycloak/keycloak:26.0-pg
    container_name: iacgenie_keycloak
    restart: always
    command:
      - start
      - --http-enabled=true
      - --http-port=8080
      - --db=postgres
      - --import-realm
      - --hostname={{ keycloak_hostname | default('https://auth.iacgenie.com') }}
      - --hostname-admin={{ keycloak_hostname | default('https://auth.iacgenie.com') }}
      - --hostname-strict=false
    environment:
      KC_BOOTSTRAP_ADMIN_USERNAME: "${KEYCLOAK_ADMIN_USER}"
      KC_BOOTSTRAP_ADMIN_PASSWORD: "${KEYCLOAK_ADMIN_PASSWORD}"
      KEYCLOAK_ADMIN: "${KEYCLOAK_ADMIN_USER}"
      KEYCLOAK_ADMIN_PASSWORD: "${KEYCLOAK_ADMIN_PASSWORD}"
      KC_DB_HOST: "postgres"
      KC_DB_PORT: "5432"
      KC_DB_NAME: "keycloak"
      KC_DB_PASSWORD: "${KC_DB_PASSWORD}"
    volumes:
      - /home/mkanavi/docker/iacgenie/data/keycloak:/opt/keycloak/data
      - ./keycloak.conf:/opt/keycloak/conf/keycloak.conf:ro
    ports:
      - "127.0.0.1:8083:8080"
    networks:
      - iacgenie-backend
    depends_on:
      - postgres
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1/8080 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 120s
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.keycloak }}"
          cpus: "1.0"
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  # =====================
  # Gitea 1.23.4
  # =====================
  gitea:
    image: gitea/gitea:1.23.4-rootless
    container_name: iacgenie_gitea
    restart: always
    environment:
      GITEA__database__DB_TYPE: postgres
      GITEA__database__HOST: postgres:5432
      GITEA__database__NAME: gitea
      GITEA__database__USER: gitea
      GITEA__database__PASSWORD: "${GITEA_DB_PASSWORD}"
      GITEA__admin__INIT_ROOT_USER_NAME: "${GITEA_ADMIN_USERNAME:-admin}"
      GITEA__admin__INIT_ROOT_USER_PASSWORD: "${GITEA_ADMIN_PASSWORD}"
      GITEA__security__INSTALL_LOCK: "true"
      GITEA__security__DISABLE_REGISTRATION: "{{ gitea_disable_registration | default('true') }}"
      GITEA__service__DISABLE_REGISTRATION: "{{ gitea_disable_registration | default('true') }}"
      GITEA__service__REGISTER_EMAIL_CONFIRM: "false"
      GITEA__service__ENABLE_NOTIFY_MAIL: "{{ gitea_enable_notify_mail | default('true') }}"
      GITEA__mailer__ENABLED: "{{ gitea_enable_notify_mail | default('true') }}"
      GITEA__mailer__SMTP_ADDR: "{{ smtp_addr | default('mail.smtp2go.com') }}"
      GITEA__mailer__SMTP_PORT: "{{ smtp_port | default('2525') }}"
      GITEA__mailer__USER: "{{ smtp_user | default('CHANGE_ME_IN_VAULT') }}"
      GITEA__mailer__PASSWD: "{{ smtp_pass | default('CHANGE_ME_IN_VAULT') }}"
      GITEA__mailer__FROM: "{{ smtp_from | default('noreply@iacgenie.com') }}"
      GITEA__security__DISABLE_GRAVATAR: "true"
      GITEA__security__ENABLE_CAPTCHA: "true"
      GITEA__security__MIN_PASSWORD_LENGTH: 12
      # 2FA enforcement (Phase 10.9)
      GITEA__security__DEFAULT_ENABLE_2FA: "{{ gitea_2fa_enforce | default('true') }}"
      GITEA__session__SESSION_LIFETIME: 86400
      GITEA__session__COOKIE_SECURE: "true"
      GITEA__security__DEFAULT_ENABLE_QUOTAS: "false"
      GITEA__api__ENABLE_SWAGGER: "true"
    volumes:
      - /home/mkanavi/docker/iacgenie/data/gitea:/var/lib/gitea
      - /home/mkanavi/docker/iacgenie/data/gitea:/etc/gitea
    ports:
      - "127.0.0.1:3000:3000"
      - "127.0.0.1:2222:2222"
    networks:
      - iacgenie-backend
    depends_on:
      - postgres
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1/3000 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 5
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.gitea }}"
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  # =====================
  # Shared Auth Wrapper — unified auth gateway for ClamAV/CrowdSec/PageGen
  # Single port 9091 mapped to internal 9096. Nginx sends X-Service header for routing.
  # =====================
  auth_wrapper:
    build:
      context: ./shared-auth-wrapper
      dockerfile: Dockerfile
    container_name: iacgenie_auth_wrapper
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1:9090 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 3
    environment:
      AUTH_KEYCLOAK_URL: "http://keycloak:8080"
      AUTH_REALM: "iacgenie"
      AUTH_CLIENT_ID: "auth-wrapper"
      AUTH_CLIENT_SECRET: "${AUTH_WRAPPER_CLIENT_SECRET}"
      AUTH_SCOPES: "openid"
      AUTH_INTERNAL_TOKEN: "${AUTH_WRAPPER_INTERNAL_TOKEN}"
      AUTH_USER_HEADER: "X-Auth-User"
      AUTH_CROWDSEC_API_KEY: "${CROWDSEC_API_KEY}"
    ports:
      - "127.0.0.1:9096:9096"
    networks:
      - iacgenie-frontend
      - iacgenie-backend
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"
    deploy:
      resources:
        limits:
          memory: "256m"

  # =====================
  # LightSerp API
  # =====================
  lightserp-api:
    image: lightserp-lightserp-api:v1.0.0
    container_name: iacgenie_lightserp_api
    restart: unless-stopped
    environment:
      LOGTIDE_URL: http://localhost:4318/v1/traces
      MINIO_ENDPOINT: "minio:9000"
      MINIO_ACCESS_KEY: "${MINIO_ROOT_USER}"
      MINIO_SECRET_KEY: "${MINIO_ROOT_PASSWORD}"
      NSQD_ADDR: "nsqd:4150"
      SEARXNG_URL: "http://searxng:8080"
      LIGHTPANDA_BIN: /usr/local/bin/lightpanda
      LIGHTSERP_S3_BASE: "iacgenie-lightserp"
      REDIS_URL: "${REDIS_URL}"
      LIGHTSERP_API_SECRET: "${LIGHTSERP_API_SECRET}"
      LIGHTSERP_DATABASE_URL: "${LIGHTSERP_DATABASE_URL}"
      LIGHTSERP_KEYCLOAK_CLIENT_SECRET: "${LIGHTSERP_KEYCLOAK_CLIENT_SECRET}"
      DATABASE_URL: "${LIGHTSERP_DATABASE_URL}"
      MAX_CONCURRENT_SCRAPES: "100"
      ENABLE_MCP_SSE: "true"
      MCP_SSE_PORT: "7805"
    ports:
      - "127.0.0.1:8000:3000"
      - "127.0.0.1:7805:7805"
    networks:
      - iacgenie-frontend
      - iacgenie-backend
      - iacgenie-messaging
    depends_on:
      - postgres
      - minio
      - nsqd
      - searxng
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:3001/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.lightserp }}"
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  # =====================
  # LightSerp WebUI
  # =====================
  lightserp-webui:
    image: lightserp-lightserp-webui:v1.0.0
    container_name: iacgenie_lightserp_webui
    restart: unless-stopped
    ports:
      - "127.0.0.1:3001:3070"
    networks:
      - iacgenie-frontend
    depends_on:
      - lightserp-api
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1/3070 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.lightserp }}"
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  # =====================
  # SearXNG (pinned for reproducibility)
  # =====================
  searxng:
    image: searxng/searxng:1.0.0
    container_name: iacgenie_searxng
    restart: unless-stopped
    environment:
      SEARXNG_SECRET: "${SEARXNG_SECRET_KEY}"
      SEARXNG_BASE_URL: "http://search.iacgenie.com"
    ports:
      - "127.0.0.1:8082:8080"
    volumes:
      - /home/mkanavi/docker/iacgenie/data/searxng:/etc/searxng
    networks:
      - iacgenie-frontend
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1/8080 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "512m"
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  # =====================
  # NSQD (pinned for reproducibility)
  # =====================
  nsqd:
    image: nsqio/nsq:v1.3.0
    container_name: iacgenie_nsqd
    restart: unless-stopped
    command: nsqd --data-path=/nsq/data
    volumes:
      - /home/mkanavi/docker/iacgenie/data/nsqd:/nsq/data
    ports:
      - "127.0.0.1:4150:4150"
      - "127.0.0.1:4151:4151"
    networks:
      - iacgenie-messaging
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1:4151 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "256m"
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  # =====================
  # PageZen
  # =====================

  # =====================
  # Logging Stack (Loki + Promtail)
  # =====================
  loki:
    image: grafana/loki:3.4.2
    container_name: iacgenie_loki
    restart: unless-stopped
    ports:
      - "127.0.0.1:3100:3100"
    networks:
      - iacgenie-frontend
    volumes:
      - ./loki/loki-config.yaml:/etc/loki/loki-config.yaml:ro
      - ./loki:/loki
    command:
      - -config.file=/etc/loki/loki-config.yaml
      - -validation.allow-structured-metadata=false
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.loki }}"
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  promtail:
    image: grafana/promtail:3.4.2
    container_name: iacgenie_promtail
    restart: unless-stopped
    networks:
      - iacgenie-frontend
    volumes:
      - /var/log:/var/log:ro
      - ./promtail/promtail-config.yaml:/etc/promtail/promtail-config.yaml:ro
    command: -config.file=/etc/promtail/promtail-config.yaml
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.promtail }}"
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  # =====================
  # Monitoring Stack (Prometheus + Grafana)
  # =====================
  prometheus:
    image: prom/prometheus:v3.2.0
    container_name: iacgenie_prometheus
    restart: unless-stopped
    ports:
      - "127.0.0.1:9090:9090"
    networks:
      - iacgenie-backend
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./prometheus:/prometheus
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time=15d"
      - "--web.console.libraries=/etc/prometheus/console_libraries"
      - "--web.console.templates=/etc/prometheus/consoles"
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.prometheus }}"
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  grafana:
    image: grafana/grafana:11.5.0
    container_name: iacgenie_grafana
    restart: unless-stopped
    ports:
      - "127.0.0.1:3004:3000"
    networks:
      - iacgenie-frontend
    volumes:
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
      - ./grafana-datasources.yml:/etc/grafana/provisioning/datasources/datasources.yml:ro
      - ./grafana-dashboards.yml:/etc/grafana/provisioning/dashboards/dashboards.yml:ro
    environment:
      GF_SECURITY_ADMIN_PASSWORD: "${GRAFANA_ADMIN_PASSWORD}"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.grafana }}"
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  # =====================
  # ClamAV Engine (virus scanning)
  # =====================
  clamav:
    image: clamav/clamav:1.1.2
    container_name: iacgenie_clamav_engine
    restart: unless-stopped
    networks:
      - iacgenie-backend
    healthcheck:
      test: ["CMD-SHELL", "clamdscan --ping=1 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.clamav }}"
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  # ClamAV Web Client (proxied through nginx)
  clamav-web-client:
    image: rguziy/clamav-web-client:1.0.0
    container_name: iacgenie_clamav_web
    restart: unless-stopped
    environment:
      CLAMAV_HOST: clamav
      CLAMAV_PORT: 3310
    ports:
      - "127.0.0.1:9092:8080"
    networks:
      - iacgenie-frontend
    depends_on:
      - clamav
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1:8080 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.clamav }}"
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  # =====================
  # CrowdSec (security)
  # =====================
  crowdsec-backend:
    image: crowdsecurity/crowdsec:latest
    container_name: iacgenie_crowdsec
    restart: unless-stopped
    ports:
      - "127.0.0.1:3033:8080"
    networks:
      - iacgenie-frontend
    volumes:
      - ./data/crowdsec:/etc/crowdsec
      - ./data/crowdsec-db:/var/lib/crowdsec/data
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1:8080 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.crowdsec }}"
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"


  # =====================
  # IacGenie Platform Frontend (React SPA) — proxy target: 3002
  # Build context: platform/ directory, Dockerfile at frontend/Dockerfile
  # =====================
  iacgenie-frontend:
    build:
      context: ./platform
      dockerfile: frontend/Dockerfile
    container_name: iacgenie_frontend
    restart: unless-stopped
    ports:
      - "127.0.0.1:3002:80"
    networks:
      - iacgenie-frontend
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1:80 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  # =====================
  # IacGenie Platform Backend (FastAPI) — proxy target: 3003
  # =====================
  iacgenie-backend:
    build:
      context: ./platform/backend
      dockerfile: Dockerfile
    container_name: iacgenie_backend
    restart: unless-stopped
    environment:
      DATABASE_URL: "${DATABASE_URL}"
      JWT_SECRET: "${JWT_SECRET}"
    ports:
      - "127.0.0.1:3003:8000"
    networks:
      - iacgenie-backend
    healthcheck:
      test: ["CMD-SHELL", "exec 6<>/dev/tcp/127.0.0.1:8000 && exec 6>&-"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"

  # =====================
  # Resume Platform API (resume.iacgenie.com)
  # Confidential Keycloak client + Keycloak SMTP email verification.
  # Host-mapped to 127.0.0.1:3006 (served by host-network nginx container).
  # =====================
  resume-api:
    build:
      context: ../resume-platform/api
      dockerfile: Dockerfile
    container_name: iacgenie_resume_api
    restart: unless-stopped
    env_file:
      - ../.env
    environment:
      - DATABASE_URL=postgresql+asyncpg://lightsrp:${PG_ROOT_PASSWORD}@postgres:5432/lightsrp
      - MINIO_ENDPOINT=minio:9000
      - MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
      - MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
      - MINIO_BUCKET=resume-files
      - KEYCLOAK_URL=http://keycloak:8080
      - KEYCLOAK_REALM=iacgenie
      - KEYCLOAK_CLIENT_ID=resume-platform
      - KEYCLOAK_CLIENT_SECRET=${RESUME_PLATFORM_CLIENT_SECRET}
      # Skip auth-wrapper (unhealthy/port-mismatch); validate via Keycloak introspection directly.
      - AUTH_WRAPPER_URL=
      - API_SECRET=${RESUME_API_SECRET}
      - ALLOWED_ORIGINS=https://resume.iacgenie.com
      - OLLAMA_URL=http://127.0.0.1:11434
      - OLLAMA_MODEL=qwen2.5:0.5b
      - MAX_FILE_SIZE_MB=10
    ports:
      - "127.0.0.1:3006:3006"
    networks:
      - iacgenie-backend
    depends_on:
      postgres:
        condition: service_healthy
      minio:
        condition: service_healthy
    deploy:
      resources:
        limits:
          memory: "512m"
          cpus: "0.5"

  # =====================
  # Resume Platform n8n (pipeline: OCR -> ATS -> LLM)
  # =====================
  n8n:
    image: docker.n8n.io/n8nio/n8n:latest
    container_name: iacgenie_n8n
    restart: unless-stopped
    env_file:
      - ../.env
    environment:
      - N8N_HOST=0.0.0.0
      - N8N_PORT=5678
      - N8N_PROTOCOL=http
      - DB_TYPE=postgresdb
      - DB_POSTGRESDB_HOST=postgres
      - DB_POSTGRESDB_DATABASE=lightsrp
      - DB_POSTGRESDB_USER=lightsrp
      - DB_POSTGRESDB_PASSWORD=${PG_ROOT_PASSWORD}
      - EXECUTIONS_MODE=queue
      - QUEUE_BULL_REDIS_HOST=redis
      - QUEUE_BULL_REDIS_PORT=6379
      - MINIO_ENDPOINT=minio:9000
      - MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
    ports:
      - "127.0.0.1:3005:5678"
    networks:
      - iacgenie-backend
    volumes:
      - /home/mkanavi/docker/iacgenie/n8n/data:/home/node/.n8n
    deploy:
      resources:
        limits:
          memory: "1g"
          cpus: "1.0"

# =====================
# Docker Network Segmentation (Phase 10.7)
# =====================
networks:
  # Frontend: nginx-exposed services
  iacgenie-frontend:
    driver: bridge
  # Backend: database, cache, object storage, auth
  iacgenie-backend:
    driver: bridge
  # Messaging: pub/sub services
  iacgenie-messaging:
    driver: bridge
