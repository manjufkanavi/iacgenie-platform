# PostgreSQL client authentication configuration
# Managed by Ansible
# TYPE  DATABASE        USER            ADDRESS                 METHOD

# Local connections — require scram-sha-256 password auth
local   all             all                                     scram-sha-256

# IPv4 local connections — require scram-sha-256 password auth
host    all             all             127.0.0.1/32            scram-sha-256

# IPv6 local connections — require scram-sha-256 password auth
host    all             all             ::1/128                 scram-sha-256

# Docker network connections — require scram-sha-256 password auth
host    all             all             0.0.0.0/0               scram-sha-256
host    all             all             ::/0                    scram-sha-256
