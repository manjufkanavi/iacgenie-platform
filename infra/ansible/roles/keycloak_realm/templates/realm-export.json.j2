# Keycloak Realm Export Template
# Generated by Ansible — render with: ansible-template realm-export.json.j2
# Used for: automatic realm import via --import-realm flag
# Note: This template generates a complete realm configuration for the iacgenie realm
# The actual realms are provisioned via the keycloak_realm Ansible role (REST API)
# This file is primarily for backup/export purposes

{
  "id": "{{ keycloak_realm }}",
  "realm": "{{ keycloak_realm }}",
  "displayName": "{{ keycloak_realm_display_name | default('IacGenie Platform') }}",
  "displayNameHtml": "",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "permanentLockout": false,
  "bruteForceStrategy": "last",
  "failureFactor": 30,
  "maxTemporaryLockouts": 0,
  "maxLifeMinutes": "10080",
  "maxFailureWaitMinutes": "900",
  "minimumQuickLoginWaitMinutes": "900",
  "waitIncrementMinutes": "60",
  "quickLoginCheckMilliSeconds": 1000,
  "maxSessions": -1,
  "refreshTokenMaxReuse": 0,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "clientSessionIdleTimeout": 0,
  "clientSessionMaxLifespan": 0,
  "clientOfflineSessionIdleTimeout": 0,
  "clientOfflineSessionMaxLifespan": 0,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "enabledEventTypes": [],
  "eventsEnabled": false,
  "eventsExpiration": 0,
  "eventsListeners": ["jboss-logging"],
  "adminEventsEnabled": false,
  "adminEventsDetailsEnabled": false,
  "enabledGrants": [],
  "groups": [],
  "defaultRoles": [
    "project-member",
    "offline_access"
  ],
  "requiredCredentials": ["password"],
  "otpPolicyPeriod": 30,
  "otpPolicyDigits": 6,
  "otpPolicyInitialCounter": 0,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpType": "totp",
  "otpPolicyTimeScale": 30,
  "passwordPolicy": "length(8) and notUsername and uppercase(1) and digits(1)",
  "smartCardMode": "disabled",
  "privateKey": "",
  "publicKey": "",
  "certName": "",
  "certAlias": "",
  "browserSecurityHeaders": {
    "contentSecurityPolicyReportOnly": "",
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xContentTypeOptions": "nosniff",
    "referrerPolicy": "no-referrer",
    "xRobotsTag": "none",
    "xFrameOptions": "SAMEORIGIN",
    "xXSSProtection": "0",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  },
  "loginTheme": "",
  "accountTheme": "",
  "adminConsoleTheme": "",
  "emailTheme": "",
  "emailSpamDetection": false,
  "tokenMinTimeRemaining": 0,
  "loginLimit": 0,
  "userManagedAccessAllowed": false,
  "attributes": {
    "_forwarder_type": "keycloak",
    "_forwarder_origin": "import",
    "clientSessionIdleNoteTimeout": "true",
    "displayOnConsentScreen": "true",
    "ocdEnforceNonce": "false",
    "frontendUrl": "",
    "acrLoaMap": "{}",
    "revokeOfflinePermForReauth": "true",
    "adminEventsDetailEnabled": "false",
    "selfRegistration": "false",
    "acr_loa_map": "{}",
    "realmReusableOtpCode": "false",
    "jfrt004542": "false",
    "sr_vc_signing_alg": "RS256",
    "_browserHeaders": "true",
    "clientOfflineSessionMaxLifespan": "0",
    "webAuthnRpIcon": "",
    "webAuthnHelperScriptEnabled": "false",
    "webAuthnAttestationConveyancePreference": "",
    "oauthDeviceCodeLifespan": "600",
    "otpPolicyAppFriendlyName": "",
    "parRequestUri": "",
    "parRequestUriLifespan": "60",
    "oidcSubAttribute": "sub",
    "_displayOnConsentScreen": "true",
    "clientSessionMaxLifesspan": "0",
    "clientOfflineSessionIdleNoteTimeout": "true",
    "oauthDevicePollingInterval": "5",
    "webAuthnRpEntityName": "{{ keycloak_realm }}",
    "webAuthnSupportOtherGenerators": "false",
    "webAuthnSigAlgs": "[]",
    "webAuthnRpId": "",
    " ClientOfflineSessionIdleTimeout": "0",
    "useRefreshTokens": "true",
    "offlineSessionIdleNoteTimeout": "true"
  },
  "users": [],
  "roles": {
    "realm": [
      {% for role in keycloak_roles %}
      {
        "name": "{{ role.name }}",
        "description": "{{ role.description | default('') }}",
        "composite": {{ role.composite | default(false) | lower }},
        "composites": {},
        "clientRole": false,
        "containerId": "{{ keycloak_realm }}"
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ],
    "client": {}
  },
  "groups": [],
  "clients": [
    {% for client in keycloak_clients %}
    {
      "clientId": "{{ client.client_id }}",
      "name": "{{ client.name | default(client.client_id) }}",
      "description": "",
      "rootUrl": "{{ client.rootUrl | default('') }}",
      "adminUrl": "{{ client.adminUrl | default('') }}",
      "baseUrl": "{{ client.baseUrl | default('') }}",
      "surrogateAuthRequired": false,
      "enabled": {{ client.enabled | default(true) | lower }},
      "clientAuthenticatorType": "{{ client.clientAuthenticatorType | default('client-secret') }}",
      "secret": "{{ client.secret | default('') }}",
      "redirectUris": {{ client.redirectUris | tojson }},
      "webOrigins": {{ client.webOrigins | tojson }},
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": {{ client.consentRequired | default(false) | lower }},
      "standardFlowEnabled": {{ client.standardFlowEnabled | default(true) | lower }},
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": {{ client.directAccessGrantsEnabled | default(false) | lower }},
      "serviceAccountsEnabled": {{ client.serviceAccountsEnabled | default(false) | lower }},
      "authorizationServicesEnabled": false,
      "publicClient": false,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "oidc.ciba.grant.enabled": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "post.logout.redirect.uris": "+"
      },
      "authenticationFlowBindingOverrides": {},
      "fullScopeAllowed": true,
      "nodeReRegistrationTimeout": -1,
      "defaultClientScopes": {{ client.defaultClientScopes | default(['web-origins', 'role_list', 'profile', 'email']) | tojson }},
      "optionalClientScopes": {{ client.optionalClientScopes | default(['address', 'phone', 'offline_access', 'microprofile-jwt']) | tojson }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
  "defaultDefaultClientScopes": [
    "role_list",
    "profile",
    "email",
    "roles",
    "web-origins",
    "acr"
  ],
  "defaultOptionalClientScopes": [
    "offline_access",
    "address",
    "phone",
    "microprofile-jwt",
    "roles"
  ],
  "browserFlow": "browser",
  "registrationFlow": "registration",
  "directGrantFlow": "direct grant",
  "resetCredentialsFlow": "reset credentials",
  "clientAuthenticationFlow": "clients",
  "dockerAuthenticationFlow": "docker auth",
  "firstLoginFlow": "first login",
  "attributes": {
    "cibaAuthenticatorSessionLifespan": "60",
    "cibaExpiresIn": "120",
    "cibaPollingInterval": "5",
    "cibaExpiresInPolicy": "0",
    "parExpiresIn": "60",
    "offlineSessionIdleNoteTimeout": "true",
    "clientOfflineSessionIdleNoteTimeout": "true",
    "_displayOnConsentScreen": "true"
  },
  "keycloakEventsConfiguration": {},
  "protocolMappers": {
    "protocolMappers": []
  }
}
