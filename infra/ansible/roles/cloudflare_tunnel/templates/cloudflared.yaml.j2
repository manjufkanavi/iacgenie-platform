# Cloudflare Tunnel configuration
# Managed by Ansible
# NOTE: Cloudflared runs as a host-level systemd service.
# All services must be reachable via 127.0.0.1:<host_port>
# Docker container hostnames are NOT resolvable from the host.
metrics: 0.0.0.0:{{ cloudflared_metrics_port | default(12345) }}
no-autoupdate: true

tunnel: {{ cloudflared_tunnel_name | default('iacgenie-tunnel') }}
credentials-file: /etc/cloudflared/{{ cloudflared_tunnel_name | default('iacgenie-tunnel') }}.json
grace-period: 30s

# Cloudflare handles SSL termination at the edge.
# Traffic flows: Cloudflare Edge → cloudflared → nginx (127.0.0.1:80) → Docker containers
# nginx reverse proxy handles hostname-based routing to correct container ports.
#
# CRITICAL: cloudflared MUST use the origin cert at /home/mkanavi/.cloudflared/cert.pem
# Generated by: cloudflared tunnel login
# Without this cert, the tunnel cannot connect to Cloudflare edge.
# The systemd service includes --origincert and TUNNEL_ORIGIN_CERT to locate it.
#
# IMPORTANT: We proxy to port 80 (not 443) because:
# - Nginx has a dedicated vHost passthrough block on port 80
# - cloudflared sends the Host header (e.g. auth.iacgenie.com)
# - Nginx routes by server_name to the correct vHost
# - No redirect loop (vHost passthrough skips HTTP→HTTPS redirect)
#
# If cert is missing after deployment:
#   ssh newvm
#   cloudflared tunnel login
#   cloudflared tunnel info {{ cloudflared_tunnel_name }}

tunnel: {{ cloudflared_tunnel_name | default('iacgenie-tunnel') }}
credentials-file: /etc/cloudflared/{{ cloudflared_tunnel_name | default('iacgenie-tunnel') }}.json
grace-period: 30s
{% if cloudflare_origin_cert | default('/home/mkanavi/.cloudflared/cert.pem') %}
origincert: {{ cloudflare_origin_cert | default('/home/mkanavi/.cloudflared/cert.pem') }}
{% endif %}

{% if cloudflare_ingress_rules | default([]) | length > 0 %}
# Custom ingress rules (from cloudflare_ingress_rules variable)
ingress:
{% for rule in cloudflare_ingress_rules %}
  - hostname: {{ rule.hostname }}
    service: {{ rule.service }}
{% endfor %}
  - service: http://status.tcp:8080
{% else %}
# Default ingress: route all *.iacgenie.com traffic through nginx reverse proxy
ingress:
  - hostname: '*.iacgenie.com'
    service: http://127.0.0.1:{{ cloudflare_origin_port | default(80) }}
  - service: http://status.tcp:8080
{% endif %}
