# Cloudflare Tunnel configuration
# Managed by Ansible — Version 4.0 (2026-08-08)
# CRITICAL: The origin cert at /home/mkanavi/.cloudflared/cert.pem is REQUIRED.
#   Without it, the tunnel cannot connect to Cloudflare edge.
#   If missing: ssh vm && cloudflared tunnel login
#   The tunnel identity (argotunnel.json) is separate from the origin cert.
#
# IMPORTANT: We proxy to port 80 (not 443) because:
# - Nginx has a dedicated vHost passthrough block on port 80
# - cloudflared sends the Host header (e.g. auth.iacgenie.com)
# - Nginx routes by server_name to the correct vHost
# - No redirect loop (vHost passthrough skips HTTP→HTTPS redirect)
#
# NOTE: cloudflared runs as a host-level systemd service.
# All services must be reachable via 127.0.0.1:<host_published_port>
# Docker container hostnames are NOT resolvable from the host.

metrics: 0.0.0.0:{{ cloudflared_metrics_port | default(12345) }}
no-autoupdate: true

tunnel: {{ cloudflared_tunnel_name | default('iacgenie-tunnel') }}
credentials-file: /etc/cloudflared/{{ cloudflared_tunnel_name | default('iacgenie-tunnel') }}.json
grace-period: 30s

# Explicit ingress rules — each service gets its own hostname mapping
# This prevents catch-all wildcard routing and ensures proper vHost selection
ingress:
  # Base domain — IacGenie landing page (NEW in v4.0)
  - hostname: iacgenie.com
    service: http://127.0.0.1:{{ cloudflare_origin_port | default(80) }}
  - hostname: www.iacgenie.com
    service: http://127.0.0.1:{{ cloudflare_origin_port | default(80) }}

  # Authentication — Keycloak
  - hostname: auth.iacgenie.com
    service: http://127.0.0.1:8083

  # Search — SearXNG
  - hostname: search.iacgenie.com
    service: http://127.0.0.1:8082

  # Git — Gitea
  - hostname: gitea.iacgenie.com
    service: http://127.0.0.1:3000

  # PageZen Docs — static auth + docs UI
  - hostname: page.iacgenie.com
    service: http://127.0.0.1:{{ cloudflare_origin_port | default(80) }}

  # IacGenie Platform — frontend UI
  - hostname: platform.iacgenie.com
    service: http://127.0.0.1:3001

  # Vault/OpenBao
  - hostname: vault.iacgenie.com
    service: http://127.0.0.1:8200

  # Monitoring — Grafana
  - hostname: grafana.iacgenie.com
    service: http://127.0.0.1:3002

  # Security — ClamAV ShieldVault
  - hostname: clamav.iacgenie.com
    service: http://127.0.0.1:9091

  # Security — CrowdSec LAPI Dashboard
  - hostname: crowdsec.iacgenie.com
    service: http://127.0.0.1:3030

  # Catch-all: any unknown *.iacgenie.com → 404 via nginx
  - hostname: '*.iacgenie.com'
    service: http://127.0.0.1:{{ cloudflare_origin_port | default(80) }}

  # Status check
  - service: http://status.tcp:8080
