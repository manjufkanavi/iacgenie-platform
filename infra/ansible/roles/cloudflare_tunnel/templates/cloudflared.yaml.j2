# Cloudflare Tunnel configuration
# Managed by Ansible — all services proxy through nginx on port 80
# nginx hostname-based routing → correct container ports

tunnel: {{ cloudflared_tunnel_name | default('iacgenie-tunnel') }}
credentials-file: /etc/cloudflared/{{ cloudflared_tunnel_name | default('iacgenie-tunnel') }}.json
no-autoupdate: true

# Cloudflare handles SSL at edge. nginx on port 80 avoids redirect loop.
ingress:
{% if cloudflared_enabled_services.auth|default(true) %}
  - hostname: auth.iacgenie.com
    service: http://127.0.0.1:80
{% endif %}
{% if cloudflared_enabled_services.search|default(true) %}
  - hostname: search.iacgenie.com
    service: http://127.0.0.1:80
{% endif %}
{% if cloudflared_enabled_services.api|default(true) %}
  - hostname: api.iacgenie.com
    service: http://127.0.0.1:80
{% endif %}
{% if cloudflared_enabled_services.app|default(true) %}
  - hostname: app.iacgenie.com
    service: http://127.0.0.1:80
{% endif %}
{% if cloudflared_enabled_services.gitea|default(true) %}
  - hostname: gitea.iacgenie.com
    service: http://127.0.0.1:80
{% endif %}
{% if cloudflared_enabled_services.page|default(true) %}
  - hostname: page.iacgenie.com
    service: http://127.0.0.1:80
{% endif %}
{% if cloudflared_enabled_services.platform|default(true) %}
  - hostname: platform.iacgenie.com
    service: http://127.0.0.1:80
{% endif %}
{% if cloudflared_enabled_services.lightserp|default(true) %}
  - hostname: lightserp.iacgenie.com
    service: http://127.0.0.1:80
{% endif %}
{% if cloudflared_enabled_services.vault|default(true) %}
  - hostname: vault.iacgenie.com
    service: http://127.0.0.1:80
{% endif %}
{% if cloudflared_enabled_services.grafana|default(true) %}
  - hostname: grafana.iacgenie.com
    service: http://127.0.0.1:80
{% endif %}
{% if cloudflared_enabled_services.clamav|default(true) %}
  - hostname: clamav.iacgenie.com
    service: http://127.0.0.1:80
{% endif %}
{% if cloudflared_enabled_services.crowdsec|default(true) %}
  - hostname: crowdsec.iacgenie.com
    service: http://127.0.0.1:80
{% endif %}
{% if cloudflared_enabled_services.pagegen|default(true) %}
  - hostname: pagegen.iacgenie.com
    service: http://127.0.0.1:80
{% endif %}
{% if cloudflared_enabled_services.catch_all|default(true) %}
  - hostname: '*.iacgenie.com'
    service: http://127.0.0.1:80
{% endif %}
  - service: http_status:200
