# Cloudflare Tunnel Configuration
# Managed by Ansible — all services proxy through Nginx on port 80
# Nginx hostname-based routing → correct container ports

tunnel: {{ cloudflared_tunnel_name }}
credentials-file: /etc/cloudflared/{{ cloudflared_tunnel_name }}.json
no-autoupdate: true

# Cloudflare handles SSL at edge. Nginx on port 80 avoids redirect loop.
ingress:
{% for svc_name, enabled in cloudflared_enabled_services.items() %}
{% if enabled %}
{% if svc_name == 'catch_all' %}
  - hostname: '*.iacgenie.com'
    service: http://{{ cloudflared_origin_host }}:{{ cloudflared_origin_port }}
{% elif svc_name == 'auth' %}
  - hostname: auth.iacgenie.com
    service: http://{{ cloudflared_origin_host }}:{{ cloudflared_origin_port }}
{% elif svc_name == 'search' %}
  - hostname: search.iacgenie.com
    service: http://{{ cloudflared_origin_host }}:{{ cloudflared_origin_port }}
{% elif svc_name == 'api' %}
  - hostname: api.iacgenie.com
    service: http://{{ cloudflared_origin_host }}:{{ cloudflared_origin_port }}
{% elif svc_name == 'app' %}
  - hostname: app.iacgenie.com
    service: http://{{ cloudflared_origin_host }}:{{ cloudflared_origin_port }}
{% elif svc_name == 'gitea' %}
  - hostname: gitea.iacgenie.com
    service: http://{{ cloudflared_origin_host }}:{{ cloudflared_origin_port }}
{% elif svc_name == 'page' %}
  - hostname: page.iacgenie.com
    service: http://{{ cloudflared_origin_host }}:{{ cloudflared_origin_port }}
{% elif svc_name == 'platform' %}
  - hostname: platform.iacgenie.com
    service: http://{{ cloudflared_origin_host }}:{{ cloudflared_origin_port }}
{% elif svc_name == 'lightserp' %}
  - hostname: lightserp.iacgenie.com
    service: http://{{ cloudflared_origin_host }}:{{ cloudflared_origin_port }}
{% elif svc_name == 'vault' %}
  - hostname: vault.iacgenie.com
    service: http://{{ cloudflared_origin_host }}:{{ cloudflared_origin_port }}
{% elif svc_name == 'grafana' %}
  - hostname: grafana.iacgenie.com
    service: http://{{ cloudflared_origin_host }}:{{ cloudflared_origin_port }}
{% elif svc_name == 'clamav' %}
  - hostname: clamav.iacgenie.com
    service: http://{{ cloudflared_origin_host }}:{{ cloudflared_origin_port }}
{% elif svc_name == 'crowdsec' %}
  - hostname: crowdsec.iacgenie.com
    service: http://{{ cloudflared_origin_host }}:{{ cloudflared_origin_port }}
{% endif %}
{% endif %}
{% endfor %}
  - service: http_status:200
