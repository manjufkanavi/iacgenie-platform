[Unit]
Description=Cloudflare Tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared \
    --config /etc/cloudflared/config.yml \
    --no-autoupdate \
    --origincert /home/mkanavi/.cloudflared/cert.pem \
    tunnel run
Restart=on-failure
RestartSec=5
# Cloudflare origin certificate is generated by `cloudflared tunnel login`
# If missing, the tunnel cannot authenticate with Cloudflare edge.
Environment=TUNNEL_ORIGIN_CERT=/home/mkanavi/.cloudflared/cert.pem

[Install]
WantedBy=multi-user.target
