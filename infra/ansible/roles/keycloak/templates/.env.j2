# Keycloak Environment Variables
# Managed by Ansible
# Hardened per Antares security audit (2026-08-17)
# Keycloak 26.x uses KC_* prefix exclusively (KEYCLOAK_* deprecated)

# =====================
# Keycloak Admin (bootstrap)
# =====================
# Use file-based secrets for production (antires: plaintext credential exposure)
KC_BOOTSTRAP_ADMIN_USERNAME={{ keycloak_admin_user | default('admin') }}
KC_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/keycloak_admin_password

# =====================
# Keycloak Database
# =====================
KC_DB_PASSWORD_FILE=/run/secrets/keycloak_db_password
KC_DB_HOST={{ keycloak_db_host | default('127.0.0.1') }}
KC_DB_PORT={{ keycloak_db_port | default(5432) }}
KC_DB_NAME={{ keycloak_db_name | default('keycloak') }}
