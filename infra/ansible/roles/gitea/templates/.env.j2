# Gitea Environment Variables
# Managed by Ansible
GITEA_ADMIN_USERNAME={{ gitea_admin_user | default('admin') }}
GITEA_ADMIN_PASSWORD={{ gitea_admin_password | default('CHANGE_ME_IN_VAULT') }}
GITEA_DB_PASSWORD={{ gitea_db_password | default('CHANGE_ME_IN_VAULT') }}
GITEA_DB_HOST={{ gitea_db_host | default('127.0.0.1') }}
GITEA_DB_PORT={{ gitea_db_port | default(5432) }}
GITEA_DB_NAME={{ gitea_db_name | default('gitea') }}
SMTP_ADDR={{ smtp_addr | default('mail.smtp2go.com') }}
SMTP_PORT={{ smtp_port | default('2525') }}
SMTP_USER={{ smtp_user | default('CHANGE_ME_IN_VAULT') }}
SMTP_PASS={{ smtp_pass | default('CHANGE_ME_IN_VAULT') }}
SMTP_FROM={{ smtp_from | default('noreply@iacgenie.com') }}
# Rate limiting (Phase 10.9)
RATE_LIMIT_WINDOW={{ gitea_rate_limit_window | default('15m') }}
RATE_LIMIT_HIGH={{ gitea_rate_limit_high | default(200) }}
RATE_LIMIT_LOW={{ gitea_rate_limit_low | default(50) }}
