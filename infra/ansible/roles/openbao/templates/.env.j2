# OpenBao Environment Variables
# Managed by Ansible — secrets from OpenBao
OPENBAO_ROOT_TOKEN={{ openbao_root_token | default('CHANGE_ME_IN_VAULT') }}
OPENBAO_DATA_DIR={{ openbao_data_dir | default('/var/lib/openbao') }}
OPENBAO_STORAGE_TYPE={{ openbao_storage_type | default('file') }}
OPENBAO_AUTO_UNSEAL={{ openbao_auto_unseal | default('false') }}
