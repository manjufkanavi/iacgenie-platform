# OpenBao Environment Variables
# Managed by Ansible — secrets sourced from OpenBao KV at {{ openbao_raft_data_dir }}/
# Service tokens: {{ openbao_raft_data_dir }}/service_tokens/
# Policies: admin (read+write), iacgenie-service (read), lightserp-service (read), terraform-service (read)

# ── OpenBao Connection ────────────────────────────────────────────────────
OPENBAO_ROOT_TOKEN={{ openbao_root_token | default('CHANGE_ME') }}
OPENBAO_ADDR=http://127.0.0.1:8200
OPENBAO_DATA_DIR={{ openbao_data_dir | default('/var/lib/openbao') }}
OPENBAO_STORAGE_TYPE={{ openbao_storage_type | default('raft') }}
OPENBAO_AUTO_UNSEAL={{ openbao_auto_unseal | default('false') }}
OPENBAO_SERVICE_TOKEN={{ openbao_service_token | default('') }}

# ── IaCGenie Secrets (sourced from iacgenie/kv) ──────────────────────────
# Read from: iacgenie/kv/data/postgres   → PG_PASSWORD
# Read from: iacgenie/kv/data/redis      → REDIS_PASSWORD
# Read from: iacgenie/kv/data/minio      → MINIO_ROOT_PASSWORD
# Read from: iacgenie/kv/data/keycloak   → KC_DB_PASSWORD
# Read from: iacgenie/kv/data/gitea      → GITEA_DB_PASSWORD
# Read from: iacgenie/kv/data/searxng    → SEARXNG_SECRET_KEY
# Read from: iacgenie/kv/data/lightserp → LIGHTSERP_API_SECRET
# Read from: iacgenie/kv/data/openbao   → OPENBAO internal root token
# ── Note: Services must read secrets from OpenBao API at runtime ──────────
