# OpenBao Environment Variables
# Managed by Ansible — secrets sourced from OpenBao vault
# Service tokens: {{ openbao_raft_data_dir }}/service_tokens/
# Policies: admin (read+write), iacgenie-service (read), lightserp-service (read)

OPENBAO_ROOT_TOKEN={{ openbao_root_token | default('CHANGE_ME_IN_VAULT') }}
OPENBAO_ADDR=https://127.0.0.1:8200
OPENBAO_DATA_DIR={{ openbao_data_dir | default('/var/lib/openbao') }}
OPENBAO_STORAGE_TYPE={{ openbao_storage_type | default('raft') }}
OPENBAO_AUTO_UNSEAL={{ openbao_auto_unseal | default('false') }}
OPENBAO_SERVICE_TOKEN={{ openbao_service_token | default('') }}
