# OpenBao Production Configuration
# Managed by Ansible — do not edit manually

# === UI ===
ui = true

# === Telemetry ===
telemetry {
  prometheus_retention_time = "30s"
  disable_hostname          = true
}

# === Listener (HTTP — TLS via Nginx/Cloudflare edge) ===
listener "tcp" {
  address     = "127.0.0.1:{{ openbao_port }}"
  tls_disable = 1
}

# === Cluster address (HTTP for single-node) ===
cluster_addr = "http://127.0.0.1:{{ openbao_port | int + 1 }}"

# === Storage (Raft) ===
storage "raft" {
  path    = "/openbao/raft"
  node_id = "node1"
}

# === Default/Max Lease TTL ===
default_lease_ttl = "768h"
max_lease_ttl     = "768h"

# === API Addr (for cluster discovery — HTTP) ===
api_addr = "http://127.0.0.1:{{ openbao_port }}"

# === Log level ===
log_level = "{{ openbao_log_level | default('info') }}"
