# =============================================================================
# Security Services — ClamAV + ShieldVault Web UI + CrowdSec LAPI Dashboard
# =============================================================================
# Version: 4.0 (2026-08-08)
# Services:
#   - clamav/clamav:latest → Antivirus engine (port 3310)
#   - shield-vault (Pradeepkumar160/shield-vault) → ClamAV Web UI with JWT auth (port 5000 → 9091)
#   - crowdsecurity/crowdsec:latest → WAF/IDS engine (port 8080)
#   - crowdsec-lapi-dashboard → CrowdSec LAPI Dashboard (port 8080 → 3030)
# Notes:
#   - CrowdSec Console (app.crowdsec.net) is cloud-only; self-hosted option is LAPI dashboard
#   - ClamAV ShieldVault provides JWT-authenticated web UI for scan management
# =============================================================================
---
name: iacgenie
services:
  # ─── ClamAV Antivirus Engine ───
  clamav:
    image: clamav/clamav:latest
    container_name: security_clamav
    restart: unless-stopped
    ports:
      - "127.0.0.1:3310:3310"
    volumes:
      - security_clamav_db:/var/lib/clamav
    healthcheck:
      test: ["CMD-SHELL", "clamdcheck || exit 1"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 120s
    networks:
      - iacgenie_backend
    deploy:
      resources:
        limits:
          memory: 1G

  # ─── ClamAV ShieldVault Web UI (port 5000 → 9091) ───
  clamav-web:
    image: pradeepkumar160/shield-vault:latest
    container_name: security_clamav_web
    restart: unless-stopped
    depends_on:
      - clamav
    environment:
      - CLAMAV_HOST=clamav
      - CLAMAV_PORT=3310
    ports:
      - "127.0.0.1:9091:5000"
    networks:
      - iacgenie_backend
    deploy:
      resources:
        limits:
          memory: 256M
          cpus: "0.25"

  # ─── CrowdSec — Core Engine (LAPI) ───
  crowdsec:
    image: crowdsecurity/crowdsec:latest
    container_name: security_crowdsec
    restart: unless-stopped
    environment:
      COLLECTIONS: "crowdsecurity/nginx crowdsecurity/http-cve crowdsecurity/whitelist-good-actors crowdsecurity/scrapy"
    volumes:
      - /var/log/nginx:/var/log/nginx:ro
      - security_crowdsec_db:/var/lib/crowdsec/data/
      - security_crowdsec_config:/etc/crowdsec/
      - security_crowdsec_home:/root
    ports:
      - "127.0.0.1:18080:8080"
    networks:
      - iacgenie_backend
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: "0.5"

  # ─── CrowdSec LAPI Dashboard (port 8080 → 3030) ───
  # Uses CrowdSec LAPI (Local API) — no self-hosted Console available
  crowdsec-web:
    image: ghcr.io/theduffman85/crowdsec-web-ui:latest
    container_name: security_crowdsec_web
    user: "1000:1000"
    restart: unless-stopped
    depends_on:
      - crowdsec
    environment:
      - CONFIG_INSTANCE_LAPI_URL=http://crowdsec:8080
      - CONFIG_INSTANCE_LAPI_AUTH_USERNAME=crowdsec-web-ui
      - CONFIG_INSTANCE_LAPI_AUTH_PASSWORD={{ CROWDSEC_WEB_UI_PASSWORD | default('crowdsec-web-password') }}
      - CONFIG_SERVER_PORT=3000
      - CONFIG_PERSIST_OVERRIDES=false
    ports:
      - "127.0.0.1:3030:3000"
    networks:
      - iacgenie_backend
    volumes:
      - security_crowdsec_web_data:/app/data
    deploy:
      resources:
        limits:
          memory: 256M
          cpus: "0.25"

volumes:
  security_clamav_db:
  security_crowdsec_db:
  security_crowdsec_config:
  security_crowdsec_home:
  security_crowdsec_web_data:

networks:
  iacgenie_backend:
    external: true
    name: iacgenie_iacgenie-backend
