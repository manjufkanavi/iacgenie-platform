# Grafana Dashboards — Service Health
# Managed by Ansible

apiVersion: 1

providers:
  - name: "iacgenie-services"
    orgId: 1
    folder: ""
    type: file
    disableDeletion: false
    updateIntervalSeconds: 10
    allowUiUpdates: true
    options:
      path: /var/lib/grafana/dashboards
      foldersFromFilesStructure: false
