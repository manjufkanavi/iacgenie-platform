#!/bin/bash
# Backup script for IacGenie infrastructure
# Managed by Ansible
set -euo pipefail

BACKUP_DIR={{ backup_dest | default('/home/mkanavi/backups') }}
RETENTION_DAYS={{ backup_retention_days | default(30) }}
DATE=$(date +%Y%m%d_%H%M%S)
LOG_FILE="/var/log/backup.log"

# Logging function
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

log "=== Starting backup ==="

# Create backup directories
mkdir -p "$BACKUP_DIR"/{postgres,redis,minio,keycloak,gitea}

# ─────────────────────────────────────────────────────────────
# Backup PostgreSQL
# ─────────────────────────────────────────────────────────────
log "Backing up PostgreSQL..."
PG_BACKUP_FILE="$BACKUP_DIR/postgres/pg_full_$DATE.sql"

# Use docker exec with PGPASSWORD for authentication
PGPASSWORD="${PG_ROOT_PASSWORD:-CHANGE_ME_IN_VAULT}" docker exec iacgenie_postgres \
    pg_dumpall -U lightsrp -d lightsrp \
    --no-password \
    2>>"$LOG_FILE" > "$PG_BACKUP_FILE"

if [ -s "$PG_BACKUP_FILE" ]; then
    # Compress backup
    gzip "$PG_BACKUP_FILE"
    PG_BACKUP_FILE="${PG_BACKUP_FILE}.gz"

    # Generate SHA256 checksum for integrity verification
    sha256sum "$PG_BACKUP_FILE" > "${PG_BACKUP_FILE}.sha256"
    log "PostgreSQL backup: $(du -h "$PG_BACKUP_FILE" | cut -f1) — checksum verified"
else
    log "ERROR: PostgreSQL backup failed or is empty"
    exit 1
fi

# ─────────────────────────────────────────────────────────────
# Backup Redis (AOF snapshot)
# ─────────────────────────────────────────────────────────────
log "Backing up Redis..."
REDIS_BACKUP_FILE="$BACKUP_DIR/redis/redis_$DATE.aof"
docker exec iacgenie_redis redis-cli BGSAVE 2>>"$LOG_FILE" || true
sleep 5
docker exec iacgenie_redis redis-cli LASTSAVE 2>>"$LOG_FILE" || true
docker exec iacgenie_redis cat /data/dump.rdb 2>/dev/null > "$REDIS_BACKUP_FILE" || \
    docker exec iacgenie_redis cat /data/appendonlydir 2>/dev/null > "$REDIS_BACKUP_FILE" || \
    log "WARNING: Redis backup could not copy data"

# ─────────────────────────────────────────────────────────────
# Backup MinIO data
# ─────────────────────────────────────────────────────────────
log "Backing up MinIO..."
MINIO_BACKUP_FILE="$BACKUP_DIR/minio/minio_$DATE.tar.gz"
docker run --rm \
    -v /home/mkanavi/docker/iacgenie/data/minio:/data:ro \
    -v "$BACKUP_DIR/minio:/backup" \
    alpine \
    tar czf /backup/minio_$DATE.tar.gz /data 2>>"$LOG_FILE"

# ─────────────────────────────────────────────────────────────
# Backup Keycloak data
# ─────────────────────────────────────────────────────────────
log "Backing up Keycloak..."
KC_BACKUP_FILE="$BACKUP_DIR/keycloak/keycloak_$DATE.tar.gz"
docker run --rm \
    -v /home/mkanavi/docker/iacgenie/data/keycloak:/data:ro \
    -v "$BACKUP_DIR/keycloak:/backup" \
    alpine \
    tar czf /backup/keycloak_$DATE.tar.gz /data 2>>"$LOG_FILE"

# ─────────────────────────────────────────────────────────────
# Backup Gitea data
# ─────────────────────────────────────────────────────────────
log "Backing up Gitea..."
GITEA_BACKUP_FILE="$BACKUP_DIR/gitea/gitea_$DATE.tar.gz"
docker run --rm \
    -v /home/mkanavi/docker/iacgenie/data/gitea:/data:ro \
    -v "$BACKUP_DIR/gitea:/backup" \
    alpine \
    tar czf /backup/gitea_$DATE.tar.gz /data 2>>"$LOG_FILE"

# ─────────────────────────────────────────────────────────────
# Clean old backups
# ─────────────────────────────────────────────────────────────
log "Cleaning old backups (>${RETENTION_DAYS} days)..."
find "$BACKUP_DIR" -type f -mtime +"$RETENTION_DAYS" -delete

# ─────────────────────────────────────────────────────────────
# Rclone sync to remote storage if enabled
# ─────────────────────────────────────────────────────────────
{% if rclone_enabled | default(false) %}
log "Syncing to {{ rclone_remote | default('gdrive') }}..."
rclone sync "$BACKUP_DIR" {{ rclone_remote | default('gdrive') }}:{{ rclone_dest | default('iacgenie-backups') }}/ \
    --max-age {{ backup_retention_days | default(30) }}d \
    --progress \
    2>>"$LOG_FILE"
{% endif %}

log "=== Backup completed successfully ==="
