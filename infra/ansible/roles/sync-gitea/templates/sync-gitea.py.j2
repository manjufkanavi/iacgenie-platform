#!/usr/bin/env python3
"""
GitHub -> Gitea Sync Script

Synchronizes repositories from GitHub to Gitea via git clone/fetch/push.
Used as cron job on VM to mirror GitHub code into Gitea for CI workflows.

Usage:
    python3 sync-gitea.py              # Sync all repos
    python3 sync-gitea.py --dry-run    # Show what would be done

Environment Variables:
    GITHUB_TOKEN   - GitHub Personal Access Token (scope: repo)
    GITEA_USER     - Gitea admin username (default: manjufkanavi)
    GITEA_PASS     - Gitea API token or password
    GITEA_BASE_URL - Gitea API base URL (default: 127.0.0.1:3000)
"""

import subprocess
import sys
import os
import argparse
from datetime import datetime

# Configuration
GITHUB_TOKEN = os.environ.get("GITHUB_TOKEN", "{{ github_token | default('') }}")
GITEA_USER = "{{ gitea_user | default('manjufkanavi') }}"
GITEA_PASS = "{{ gitea_pass | default('') }}"
GITHUB_ORG = "manjufkanavi"
GITEA_BASE_URL = "{{ gitea_base_url | default('127.0.0.1:3000') }}"
REPO_DIR = "/tmp/gitea-sync-work"
LOG_FILE = "/home/mkanavi/bin/sync-gitea.log"

REPOS = {{ repos | default([
    {"name": "iacgenie", "gitea_name": "iacgenie"},
    {"name": "iacgenie-unified-infra", "gitea_name": "iacgenie-unified-infra"},
    {"name": "LightSerp", "gitea_name": "LightSerp"},
]) }}


def log(msg):
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] {msg}"
    print(line)
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    with open(LOG_FILE, "a") as f:
        f.write(line + "\n")


def git_cmd(*args, cwd=None):
    cmd = ["git"] + list(args)
    result = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=300)
    return result.returncode, result.stdout.strip(), result.stderr.strip()


def sync_repo(repo):
    """Sync a single repo from GitHub to Gitea."""
    name = repo["name"]
    gname = repo["gitea_name"]
    log(f"=== Syncing: {name} ===")

    gh_url = f"https://x-access-token:{GITHUB_TOKEN}@github.com/{GITHUB_ORG}/{name}.git"
    gitea_url = f"http://{GITEA_USER}:{GITEA_PASS}@{GITEA_BASE_URL}/{GITEA_USER}/{gname}.git"

    work_dir = os.path.join(REPO_DIR, name)
    os.makedirs(REPO_DIR, exist_ok=True)

    if os.path.isdir(os.path.join(work_dir, ".git")):
        # Already cloned, fetch and rebase
        git_cmd("remote", "set-url", "origin", gh_url, cwd=work_dir)
        ret, out, err = git_cmd("fetch", "origin", cwd=work_dir)
        if ret != 0:
            log(f"  ERROR fetch: {err}")
            return {"name": name, "status": "error", "message": f"fetch failed: {err}"}

        # Detect main branch
        ret, origin_head, _ = git_cmd("rev-parse", "origin/main", cwd=work_dir)
        if ret != 0:
            ret, origin_head, _ = git_cmd("rev-parse", "origin/master", cwd=work_dir)
            branch = "master" if ret == 0 else "main"
        else:
            branch = "main"

        # Update local
        git_cmd("checkout", branch, cwd=work_dir)
        git_cmd("reset", "--hard", f"origin/{branch}", cwd=work_dir)
        ret, out, err = git_cmd("push", "gitea", f"HEAD:refs/heads/{branch}", "--force", cwd=work_dir)
        if ret != 0:
            log(f"  ERROR push: {err}")
            return {"name": name, "status": "error", "message": f"push failed: {err}"}

        ret, commit, _ = git_cmd("rev-parse", "--short", "HEAD", cwd=work_dir)
        log(f"  [UPDATED] {name}: {commit}")
        return {"name": name, "status": "ok", "commit": commit, "branch": branch, "message": "Updated"}
    else:
        # Fresh clone
        ret, out, err = git_cmd("clone", gh_url, work_dir)
        if ret != 0:
            log(f"  ERROR clone: {err}")
            return {"name": name, "status": "error", "message": f"clone failed: {err}"}

        ret, branch_out, _ = git_cmd("branch", "--show-current", cwd=work_dir)
        branch = branch_out.strip() or "main"

        # Add gitea remote and push
        git_cmd("remote", "add", "gitea", gitea_url, cwd=work_dir)
        ret, out, err = git_cmd("push", "gitea", f"HEAD:refs/heads/{branch}", "--force", cwd=work_dir)
        if ret != 0:
            log(f"  ERROR push: {err}")
            return {"name": name, "status": "error", "message": f"push failed: {err}"}

        ret, commit, _ = git_cmd("rev-parse", "--short", "HEAD", cwd=work_dir)
        log(f"  [CLONED] {name}: {commit}")
        return {"name": name, "status": "ok", "commit": commit, "branch": branch, "message": "Cloned"}


def run_sync(dry_run=False):
    """Run sync for all repos and return results."""
    if dry_run:
        log("=== DRY RUN ===")
        for repo in REPOS:
            log(f"  Would sync: {repo['name']} -> {repo['gitea_name']}")
        return [{"name": r["name"], "status": "dry_run", "message": "dry_run"} for r in REPOS]

    results = []
    for repo in REPOS:
        result = sync_repo(repo)
        results.append(result)
        import time
        time.sleep(2)
    return results


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="GitHub -> Gitea Sync")
    parser.add_argument("--dry-run", action="store_true", help="Show what would be done")
    args = parser.parse_args()

    if not GITHUB_TOKEN:
        log("ERROR: GITHUB_TOKEN not set")
        sys.exit(1)
    if not GITEA_PASS:
        log("ERROR: GITEA_PASS not set")
        sys.exit(1)

    log("Starting GitHub -> Gitea sync...")
    results = run_sync(dry_run=args.dry_run)
    success = sum(1 for r in results if r["status"] == "ok")
    log(f"Sync complete: {success}/{len(results)} repos synced successfully")
    sys.exit(0 if success == len(results) else 1)
