server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions.yaml

clients:
  - url: http://loki:3100/loki/api/v1/push

scrape_configs:
  # ── Docker container logs ──
  - job_name: docker-containers
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 5s
    relabel_configs:
      - source_labels: ["__meta_docker_container_name"]
        regex: "/(iacgenie_.*)"
        target_label: "container"
        replacement: "$1"
      - source_labels: ["__meta_docker_container_log_stream"]
        target_label: "logstream"
      - source_labels: ["__meta_docker_container_label_com_docker_compose_service"]
        target_label: "service"

  # ── Systemd journald logs (VM host services) ──
  - job_name: systemd-journal
    journal:
      path: /run/log/journal
      max_age: 12h
      labels:
        job: systemd-journal
    relabel_configs:
      - source_labels: ["__journal__systemd_unit"]
        target_label: "unit"
      - source_labels: ["__journal__machine_id"]
        target_label: "machine"
      - source_labels: ["__journal___uid"]
        target_label: "uid"

  # ── Nginx access/error logs ──
  - job_name: nginx-logs
    static_configs:
      - targets:
          - localhost
        labels:
          job: nginx-logs
          __path__: /var/log/nginx/*.log

  # ── Cloudflared logs ──
  - job_name: cloudflared-logs
    static_configs:
      - targets:
          - localhost
        labels:
          job: cloudflared-logs
          __path__: /var/log/cloudflared/*.log

  # ── OpenBao audit/app logs ──
  - job_name: openbao-logs
    static_configs:
      - targets:
          - localhost
        labels:
          job: openbao-logs
          __path__: /home/mkanavi/docker/iacgenie/openbao_data/openbao-*.log

  # ── Docker daemon logs ──
  - job_name: docker-daemon
    static_configs:
      - targets:
          - localhost
        labels:
          job: docker-daemon
          __path__: /var/log/dockerd.log
