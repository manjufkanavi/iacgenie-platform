version: "3.8"
# =============================================================================
# IacGenie Platform — Monitoring Stack
# =============================================================================
# Services: Prometheus, Grafana, Loki, Promtail
# Deployment: Docker Compose
# Data Retention: 30 days
# =============================================================================

networks:
  iacgenie-frontend:
    name: iacgenie-frontend
    driver: bridge
  iacgenie-metrics:
    name: iacgenie-metrics
    driver: bridge

services:
  # =========================================================================
  # Prometheus — Metrics collection (30-day retention)
  # =========================================================================
  prometheus:
    image: prom/prometheus:v2.53.0
    container_name: iacgenie_prometheus
    restart: unless-stopped
    user: "0"
    ports:
      - "127.0.0.1:9090:9090"
    volumes:
      - /home/mkanavi/docker/iacgenie/prometheus/data:/prometheus
      - /home/mkanavi/docker/iacgenie/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - /home/mkanavi/docker/iacgenie/prometheus/alert_rules.yml:/etc/prometheus/alert_rules.yml:ro
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time=30d"
      - "--storage.tsdb.retention.size=10GB"
      - "--web.enable-lifecycle"
      - "--web.enable-admin-api"
      - "--web.console.libraries=/etc/prometheus/console_libraries"
      - "--web.console.templates=/etc/prometheus/consoles"
    networks:
      - iacgenie-metrics
      - iacgenie-frontend
    deploy:
      resources:
        limits:
          memory: 1G
          cpus: "1.0"
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:9090/-/healthy"]
      interval: 15s
      timeout: 5s
      retries: 3

  # =========================================================================
  # Alertmanager — Alert routing (email + Telegram)
  # =========================================================================
  alertmanager:
    image: prom/alertmanager:v0.27.0
    container_name: iacgenie_alertmanager
    restart: unless-stopped
    ports:
      - "127.0.0.1:9093:9093"
    volumes:
      - /home/mkanavi/docker/iacgenie/prometheus/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
    command:
      - "--config.file=/etc/alertmanager/alertmanager.yml"
    networks:
      - iacgenie-metrics
    deploy:
      resources:
        limits:
          memory: 256M
          cpus: "0.25"

  # =========================================================================
  # Grafana — Dashboards & visualization
  # =========================================================================
  grafana:
    image: grafana/grafana:11.2.0
    container_name: iacgenie_grafana
    restart: unless-stopped
    user: "472"
    ports:
      - "127.0.0.1:3001:3000"
    environment:
      GF_SERVER_ROOT_URL: https://grafana.iacgenie.com
      GF_SERVER_DOMAIN: grafana.iacgenie.com
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_AUTH_BASIC_ENABLED: "true"
      GF_SECURITY_ADMIN_USER: ${GRAFANA_ADMIN_USER:-admin}
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_ADMIN_PASSWORD}
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_PANELS_DISABLE_SANITIZE_HTML: "true"
      GF_INSTALL_PLUGINS: grafana-clock-panel,grafana-worldmap-panel
    volumes:
      - /home/mkanavi/docker/iacgenie/grafana:/var/lib/grafana
      - /home/mkanavi/docker/iacgenie/grafana/provisioning:/etc/grafana/provisioning:ro
    networks:
      - iacgenie-frontend
    depends_on:
      - prometheus
      - loki
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: "0.5"
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:3000/api/health | grep -q 'ok'"]
      interval: 30s
      timeout: 10s
      retries: 3

  # =========================================================================
  # Loki — Log aggregation (30-day retention)
  # =========================================================================
  loki:
    image: grafana/loki:2.9.8
    container_name: iacgenie_loki
    restart: unless-stopped
    ports:
      - "127.0.0.1:3100:3100"
    volumes:
      - /home/mkanavi/docker/iacgenie/loki:/loki
      - /home/mkanavi/docker/iacgenie/loki/config.yml:/etc/loki/config.yml:ro
    command: -config.file=/etc/loki/config.yml
    networks:
      - iacgenie-metrics
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: "0.5"
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:3100/ready"]
      interval: 15s
      timeout: 5s
      retries: 3

  # =========================================================================
  # Promtail — Log shipper (ships all Docker logs to Loki)
  # =========================================================================
  promtail:
    image: grafana/promtail:2.9.8
    container_name: iacgenie_promtail
    restart: unless-stopped
    volumes:
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /home/mkanavi/docker/iacgenie/loki/promtail.yml:/etc/promtail/config.yml:ro
    command: -config.file=/etc/promtail/config.yml
    networks:
      - iacgenie-metrics
    deploy:
      resources:
        limits:
          memory: 128M
          cpus: "0.25"

networks:
  iacgenie-frontend:
    external: true
  iacgenie-metrics:
    external: true
