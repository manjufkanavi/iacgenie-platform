# Auth Wrapper Environment Configuration
# Copy to .env and fill in values

# Keycloak OAuth2 settings
AUTH_KEYCLOAK_URL=http://keycloak:8080
AUTH_REALM=iacgenie
AUTH_CLIENT_ID=auth-wrapper
AUTH_CLIENT_SECRET=
AUTH_SCOPES=openid
AUTH_REDIRECT_URI=https://clamav.iacgenie.com/callback
AUTH_INTERNAL_TOKEN=
AUTH_USER_HEADER=X-Auth-User

# CrowdSec API key (for auth fallback)
AUTH_CROWDSEC_API_KEY=
