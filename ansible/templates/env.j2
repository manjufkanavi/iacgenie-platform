# OpenBao-secrets-only environment (NO hardcoded passwords)
# Generated by Ansible from GitHub Actions repository secrets
# All secrets synced from OpenBao → GitHub Secrets

# OpenBao configuration
OPENBAO_ADDR=http://127.0.0.1:8200
{% if secrets_dict.get('OPENBAO_ROOT_TOKEN', '') %}
OPENBAO_ROOT_TOKEN={{ secrets_dict['OPENBAO_ROOT_TOKEN'] }}{% endif %}

# Service tokens
{% if secrets_dict.get('IACGENIE_SERVICE_TOKEN', '') %}
